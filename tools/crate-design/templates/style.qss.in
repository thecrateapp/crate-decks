/*
  Crate Decks skin: the style of the CrateDecks skin (plan V2), with the
  language of the Crate admin (design 14.1) and the values of the approved
  GU1 mockups (crate-agents/decks-mockups/lib/decks.css).

  Template for tools/crate-design/generate.py: the placeholders in double
  braces come from res/crate-design/tokens.json. Do not write colours, sizes, radii or
  fonts by hand here (AGENTS.md 5.2).

  The skin loads LateNight's style first (skin.xml, root <Style>) for the
  parts that V2 has not redone yet, and this file last, as the style of the
  Crate scheme, so that its rules win.

  Every widget whose object name starts with "Mono" is a MonoLabel. Qt's
  QSS takes text-transform and letter-spacing, but reads letter-spacing in
  em as a percentage of the glyph's width: the tracking is given in px,
  tracking times font size. What QSS cannot set at all, the tabular figures
  and optical size of the deck numbers, C++ sets on the widgets whose object
  name starts with "DeckNumber" (crate/ui/skin/crateskin.cpp).
*/

/* ── Window ─────────────────────────────────────────────────────────── */

#Mixxx,
#SkinContainer {
  background-color: {{bgApp}};
}

/* Body text in Roboto, as the admin */
#Mixxx,
WWidget,
WLabel,
WNumber, WNumberPos,
WPushButton,
WKey,
WTime,
WTrackProperty,
WRecordingDuration {
  font-family: "{{fontBody}}";
  font-weight: {{fontWeightBody}};
}

QToolTip {
  background-color: {{bgPopover}};
  border: {{strokeHairline}} solid {{border}};
  border-radius: {{radiusMd}};
  color: {{textPrimary}};
  font-family: "{{fontBody}}";
  font-size: {{fontSizeCaption}};
  padding: {{monoSeparatorPadding}};
}

/* ── MonoLabel (MonoLabel.tsx): mono 400, textSubtle ─────────────────── */

/* At the size the GU1 mockups paint it: --text-label is 0.6875rem and their
   root is 15 px. The deck letters, the phrase and pitch readouts and the
   toolbar buttons are 11 px mono in the mockups, not MonoLabels. */
[objectName^="Mono"] {
  font-family: "{{fontMono}}";
  font-weight: {{fontWeightMono}};
  font-size: {{fontSizeMonoLabel.fontsize}};
  text-transform: uppercase;
  letter-spacing: {{trackingCaps * fontSizeMonoLabel}};
  color: {{textSubtle}};
}

/* ── Toolbar: 64 px with a 1 px rule, as the admin top bar ───────────── */

/* QSS sizes are content sizes: Qt adds padding and border to them.
   WWidgetGroup applies qproperty-layoutContentsMargins twice, to the widget
   and to its layout, so the margins below are half the gutter. */
#CrateToolbar {
  background-color: {{bgApp}};
  border: 0;
  border-bottom: {{strokeHairline}} solid {{border}};
  padding: 0;
  min-height: {{topbarHeight - strokeHairline}};
  max-height: {{topbarHeight - strokeHairline}};
  qproperty-layoutSpacing: 0;
  qproperty-layoutContentsMargins: rect({{gutter.half.number}} 0 {{gutter.half.number}} 0);
}
/* Narrower than the 1366 layout breakpoint */
#CrateToolbar[highlight="1"] {
  qproperty-layoutContentsMargins: rect({{gutterNarrow.half.number}} 0 {{gutterNarrow.half.number}} 0);
}
/* The row of controls, centred in the bar. Its explicit minimum width lets
   the window shrink below the wide row, so that the skin can reach the
   1366 layout breakpoint and switch to the narrow row. */
#CrateToolbarRow {
  min-width: {{strokeHairline}};
  padding: 0;
  qproperty-layoutContentsMargins: rect(0 0 0 0);
  min-height: {{heightControlSm}};
  max-height: {{heightControlSm}};
  qproperty-layoutSpacing: {{toolbarGap.number}};
}
#CrateToolbarRow[highlight="1"] {
  qproperty-layoutSpacing: {{toolbarGapNarrow.number}};
}

#CrateToolbarBrand {
  qproperty-layoutSpacing: {{brandGap.number}};
}
#CrateToolbarLogo {
  image: url(skins:CrateDecks/generated/crate-logo.svg);
  margin: {{heightControlSm - brandLogoHeight.half}} 0;
  min-width: {{brandLogoWidth}};
  max-width: {{brandLogoWidth}};
  min-height: {{brandLogoHeight}};
  max-height: {{brandLogoHeight}};
}
#CrateToolbarBrandName {
  font-family: "{{fontBody}}";
  font-size: {{fontSizeBrand}};
  font-weight: {{fontWeightTitle}};
  color: {{textPrimary}};
}

#CrateToolbarSeparator {
  background-color: {{border}};
  margin: {{heightControlSm - toolbarSeparatorHeight.half}} 0;
  min-width: {{strokeHairline}};
  max-width: {{strokeHairline}};
  min-height: {{toolbarSeparatorHeight}};
  max-height: {{toolbarSeparatorHeight}};
}

#CrateToolbarGroup {
  qproperty-layoutSpacing: {{toolbarGroupGap.number}};
}

/* Toolbar buttons: a MonoLabel text under a transparent button that draws
   the icon, the border and the active fill (controls/tb_button*.xml). The
   text leaves room for the icon with a transparent border. */
#MonoTbButtonText {
  color: {{textMuted}};
  margin-left: {{toolbarButtonPadding}};
  border-left: {{iconMd}} solid transparent;
  padding-left: {{iconTextGap}};
  padding-right: {{toolbarButtonPadding}};
  min-height: {{heightControlSm}};
  max-height: {{heightControlSm}};
}
#MonoTbButtonText[highlight="1"] {
  color: {{accentHi}};
}

/* QSS sizes are content sizes: Qt adds the padding and the border, so the
   button is 32 x 32 with an 18 px icon 7 px from its left edge. */
[objectName^="TbIcon"] {
  background-color: transparent;
  border: {{strokeHairline}} solid transparent;
  border-radius: {{radiusMd}};
  image-position: left;
  padding-left: {{toolbarButtonPaddingNarrow - strokeHairline}};
  padding-top: {{heightControlSm - iconMd - strokeHairline - strokeHairline.half}};
  padding-bottom: {{heightControlSm - iconMd - strokeHairline - strokeHairline.half}};
  min-width: {{heightControlSm - toolbarButtonPaddingNarrow - strokeHairline}};
  min-height: {{iconMd}};
  max-height: {{iconMd}};
}
/* With text, the icon keeps the text button's own padding */
#TbButton [objectName^="TbIcon"] {
  padding-left: {{toolbarButtonPadding - strokeHairline}};
}
[objectName^="TbIcon"][displayValue="1"] {
  border-color: {{accentHiBorder}};
  background-color: {{accentBg}};
}

#TbIconDecks2, #TbIconDecks4 { image: url(skins:CrateDecks/generated/icons/widget_idle.svg); }
#TbIconDecks2[displayValue="1"], #TbIconDecks4[displayValue="1"] { image: url(skins:CrateDecks/generated/icons/widget_active.svg); }
#TbIconFx { image: url(skins:CrateDecks/generated/icons/tuning_idle.svg); }
#TbIconFx[displayValue="1"] { image: url(skins:CrateDecks/generated/icons/tuning_active.svg); }
#TbIconSamplers { image: url(skins:CrateDecks/generated/icons/cassette-2_idle.svg); }
#TbIconSamplers[displayValue="1"] { image: url(skins:CrateDecks/generated/icons/cassette-2_active.svg); }
#TbIconMicAux { image: url(skins:CrateDecks/generated/icons/microphone_idle.svg); }
#TbIconMicAux[displayValue="1"] { image: url(skins:CrateDecks/generated/icons/microphone_active.svg); }
#TbIconSmartMix { image: url(skins:CrateDecks/generated/icons/stars_idle.svg); }
#TbIconSmartMix[displayValue="1"] { image: url(skins:CrateDecks/generated/icons/stars_active.svg); }
#TbIconAutoDj { image: url(skins:CrateDecks/generated/icons/shuffle_idle.svg); }
#TbIconAutoDj[displayValue="1"] { image: url(skins:CrateDecks/generated/icons/shuffle_active.svg); }
#TbIconRecord { image: url(skins:CrateDecks/generated/icons/record-circle_idle.svg); }
#TbIconRecord[displayValue="1"], #TbIconRecord[displayValue="2"] { image: url(skins:CrateDecks/generated/icons/record-circle_active.svg); }
#TbIconBroadcast { image: url(skins:CrateDecks/generated/icons/station_idle.svg); }
#TbIconBroadcast[displayValue="1"], #TbIconBroadcast[displayValue="2"] { image: url(skins:CrateDecks/generated/icons/station_active.svg); }
#TbIconSettings { image: url(skins:CrateDecks/generated/icons/settings_idle.svg); }
#TbIconSettings[displayValue="1"] { image: url(skins:CrateDecks/generated/icons/settings_active.svg); }
/* The icon-only buttons of the admin have no border or fill when active */
#TbIconRecord[displayValue="1"], #TbIconRecord[displayValue="2"],
#TbIconBroadcast[displayValue="1"], #TbIconBroadcast[displayValue="2"],
#TbIconSettings[displayValue="1"] {
  border-color: transparent;
  background-color: transparent;
}

/* Crate status (StatusDot.tsx): server and connection. C++ sets the
   crateState property: connected, connecting, signedOut or none. */
#CrateStatus {
  qproperty-layoutSpacing: {{iconTextGap.number}};
}
#CrateStatusDot {
  background-color: {{textSubtle}};
  border-radius: {{statusDot.half}};
  margin: {{heightControlSm - statusDot.half}} 0;
  min-width: {{statusDot}};
  max-width: {{statusDot}};
  min-height: {{statusDot}};
  max-height: {{statusDot}};
}
#CrateStatusDot[crateState="connected"] { background-color: {{accentHi}}; }
#CrateStatusDot[crateState="connecting"] { background-color: {{textMuted}}; }
#CrateStatusDot[crateState="signedOut"] { background-color: {{warning}}; }
#MonoCrateStatus[crateState="connected"] { color: {{accentHi}}; }
#MonoCrateStatus[crateState="connecting"] { color: {{textMuted}}; }
#MonoCrateStatus[crateState="signedOut"] { color: {{warningText}}; }

/* Readings: MonoLabel over a 1 px lane */
#CrateToolbarReading {
  qproperty-layoutSpacing: {{readingGap.number}};
  min-width: {{readingMinWidth}};
}
#CrateToolbarReadingRow {
  qproperty-layoutSpacing: 0;
}

#CrateToolbarClock {
  font-family: "{{fontMono}}";
  font-weight: {{fontWeightMono}};
  font-size: {{fontSizeBody}};
  color: {{textPrimary}};
}

/* ── Waveforms (decks.css .wf): a row per deck ─────────────────────── */

#CrateMain,
#CrateMainLibrary {
  background-color: {{bgApp}};
}
/* The band's bottom rule is a group of its own: a border on the band would
   be drawn over its last row, which fills it */
#CrateWaveformBandRule {
  background-color: {{border}};
  min-height: {{strokeHairline}};
  max-height: {{strokeHairline}};
}
#CrateWaveformRowTwo {
  min-height: {{waveformRowHeight}};
  max-height: {{waveformRowHeight}};
}
#CrateWaveformRowTwo[highlight="1"] {
  min-height: {{waveformRowHeightShort}};
  max-height: {{waveformRowHeightShort}};
}
#CrateWaveformRowFour {
  min-height: {{waveformRowHeightFour}};
  max-height: {{waveformRowHeightFour}};
}
#CrateWaveformRowFour[highlight="1"] {
  min-height: {{waveformRowHeightFourShort}};
  max-height: {{waveformRowHeightFourShort}};
}
/* The rows after the first: their rule is part of their height, as the
   mockups' .wf-row + .wf-row border */
#CrateWaveformRowTwoNext {
  min-height: {{waveformRowHeight - strokeHairline}};
  max-height: {{waveformRowHeight - strokeHairline}};
}
#CrateWaveformRowTwoNext[highlight="1"] {
  min-height: {{waveformRowHeightShort - strokeHairline}};
  max-height: {{waveformRowHeightShort - strokeHairline}};
}
#CrateWaveformRowFourNext {
  min-height: {{waveformRowHeightFour - strokeHairline}};
  max-height: {{waveformRowHeightFour - strokeHairline}};
}
#CrateWaveformRowFourNext[highlight="1"] {
  min-height: {{waveformRowHeightFourShort - strokeHairline}};
  max-height: {{waveformRowHeightFourShort - strokeHairline}};
}
/* Over the maximised library (library-compatibles.html --wf-h): 44 px with
   two decks, the short four-deck rows with four, at any window height */
#CrateWaveformRowLibraryTwo,
#CrateWaveformRowLibraryTwo[highlight="1"] {
  min-height: {{waveformRowHeightLibrary}};
  max-height: {{waveformRowHeightLibrary}};
}
#CrateWaveformRowLibraryTwoNext,
#CrateWaveformRowLibraryTwoNext[highlight="1"] {
  min-height: {{waveformRowHeightLibrary - strokeHairline}};
  max-height: {{waveformRowHeightLibrary - strokeHairline}};
}
#CrateWaveformRowLibraryFour,
#CrateWaveformRowLibraryFour[highlight="1"] {
  min-height: {{waveformRowHeightFourShort}};
  max-height: {{waveformRowHeightFourShort}};
}
#CrateWaveformRowLibraryFourNext,
#CrateWaveformRowLibraryFourNext[highlight="1"] {
  min-height: {{waveformRowHeightFourShort - strokeHairline}};
  max-height: {{waveformRowHeightFourShort - strokeHairline}};
}
#CrateWaveformRule,
#CrateDeckRule {
  min-height: {{strokeHairline}};
  max-height: {{strokeHairline}};
}
#CrateWaveformRule {
  background-color: {{borderSubtle}};
}
#CrateDeckRule {
  background-color: {{border}};
}
#CrateWaveformGutter {
  border-right: {{strokeHairline}} solid {{borderSubtle}};
  padding: {{waveformGutterPadding}} 0;
  min-width: {{waveformGutterWidth - strokeHairline}};
  max-width: {{waveformGutterWidth - strokeHairline}};
}
#CrateWaveLetterAC,
#CrateWaveLetterBD {
  font-family: "{{fontMono}}";
  font-size: {{fontSizeCaption}};
}
#CrateWaveLetterAC { color: {{deckA}}; }
#CrateWaveLetterBD { color: {{deckB}}; }
#CrateWaveDotAC,
#CrateWaveDotBD {
  background-color: {{textFaint}};
  border-radius: {{statusDot.half}};
  min-width: {{statusDot}};
  max-width: {{statusDot}};
  min-height: {{statusDot}};
  max-height: {{statusDot}};
}
#CrateWaveDotAC[highlight="1"] { background-color: {{deckA}}; }
#CrateWaveDotBD[highlight="1"] { background-color: {{deckB}}; }

/* ── Decks and mixer (decks.css .decks) ─────────────────────────────── */

#CrateDecksRow {
  border-bottom: {{strokeHairline}} solid {{border}};
}
#CrateMixerRule {
  background-color: {{border}};
  min-width: {{strokeHairline}};
  max-width: {{strokeHairline}};
}

/* A deck: padding of .deck, the gutter narrower below the 1366
   breakpoint; the pitch column 14 px from the deck. A group's padding does
   not follow a restyle, so the paddings are layout margins, which
   WWidgetGroup applies twice (half the value each time). With four decks
   below the 768 breakpoint the mockups' 7 px becomes 8. */
#CrateDeck {
  qproperty-layoutContentsMargins: rect(0 {{deckPaddingTop.half.number}} 0 {{deckPaddingBottom.half.number}});
}
#CrateDeck[highlight="1"],
#CrateDeckFour {
  qproperty-layoutContentsMargins: rect(0 {{deckPaddingShort.half.number}} 0 {{deckPaddingShort.half.number}});
}
#CrateDeckFour[highlight="1"] {
  qproperty-layoutContentsMargins: rect(0 {{deckPaddingFourShort + strokeHairline.half.number}} 0 {{deckPaddingFourShort + strokeHairline.half.number}});
}
#CrateDeckSides,
#CrateDeckFourSides {
  qproperty-layoutContentsMargins: rect({{gutter.half.number}} 0 {{gutter.half.number}} 0);
  qproperty-layoutSpacing: {{deckColumnGap.number}};
}
#CrateDeckSides[highlight="1"],
#CrateDeckFourSides[highlight="1"] {
  qproperty-layoutContentsMargins: rect({{gutterNarrow.half.number}} 0 {{gutterNarrow.half.number}} 0);
}
#CrateDeckMain,
#CrateDeckBody {
  qproperty-layoutSpacing: {{deckRowGap.number}};
}
#CrateDeckMain[highlight="1"],
#CrateDeckBody[highlight="1"],
#CrateDeckMainFour,
#CrateDeckBodyFour {
  qproperty-layoutSpacing: {{deckRowGapShort.number}};
}
#CrateDeckMainFour[highlight="1"],
#CrateDeckBodyFour[highlight="1"] {
  qproperty-layoutSpacing: {{deckRowGapFourShort.number}};
}

/* Header: letter box, MonoLabel, Leader badge, Crate state, menu */
#CrateDeckHead {
  qproperty-layoutSpacing: {{deckHeadGap.number}};
  min-height: {{menuButtonSize}};
  max-height: {{menuButtonSize}};
}
#CrateDeckHeadMeta {
  qproperty-layoutSpacing: 0;
}
#CrateDeckLetterAC,
#CrateDeckLetterBD {
  font-family: "{{fontMono}}";
  font-size: {{fontSizeLabel}};
  border-radius: {{radiusSm}};
  min-width: {{deckLetterSize - strokeHairline - strokeHairline}};
  max-width: {{deckLetterSize - strokeHairline - strokeHairline}};
  min-height: {{deckLetterSize - strokeHairline - strokeHairline}};
  max-height: {{deckLetterSize - strokeHairline - strokeHairline}};
}
#CrateDeckLetterAC { border: {{strokeHairline}} solid {{deckA}}; color: {{deckA}}; }
#CrateDeckLetterBD { border: {{strokeHairline}} solid {{deckB}}; color: {{deckB}}; }
#MonoDeckHeadSep {
  padding: 0 {{monoSeparatorPadding}};
}
/* InfoBadge, accent tone */
#CrateDeckLeader {
  font-family: "{{fontMono}}";
  font-size: {{fontSizeMeta.fontsize}};
  color: {{accentHi}};
  background-color: {{accentBg}};
  border: {{strokeHairline}} solid {{accentHiBorder}};
  border-radius: {{badgeHeight.half}};
  padding: 0 {{badgePadding}};
  min-height: {{badgeHeight - strokeHairline - strokeHairline}};
  max-height: {{badgeHeight - strokeHairline - strokeHairline}};
}
#CrateDeckTrackState {
  qproperty-layoutSpacing: {{iconTextGap.number}};
}
#CrateDeckStateDot {
  background-color: {{accentHi}};
  border-radius: {{statusDot.half}};
  margin: {{menuButtonSize - statusDot.half}} 0;
  min-width: {{statusDot}};
  max-width: {{statusDot}};
  min-height: {{statusDot}};
  max-height: {{statusDot}};
}
#MonoDeckState {
  color: {{accentHi}};
}
#CrateDeckMenuButton {
  background-color: transparent;
  border: {{strokeHairline}} solid transparent;
  border-radius: {{radiusMd}};
  image: url(skins:CrateDecks/generated/icons/menu-dots_idle.svg);
  padding: {{menuButtonSize - iconMd - strokeHairline - strokeHairline.half}};
  min-width: {{iconMd}};
  max-width: {{iconMd}};
  min-height: {{iconMd}};
  max-height: {{iconMd}};
}
#CrateDeckMenuButton[displayValue="1"] {
  image: url(skins:CrateDecks/generated/icons/menu-dots_active.svg);
}

/* Track row: cover, title, artist and genre, the deck numbers */
#CrateDeckTrack,
#CrateDeckTrackFour {
  qproperty-layoutSpacing: {{deckTrackGap.number}};
}
#CrateDeckTrack[highlight="1"],
#CrateDeckTrackFour[highlight="1"] {
  qproperty-layoutSpacing: {{deckTrackGapNarrow.number}};
}
#CrateDeckCover {
  min-width: {{coverSize}};
  max-width: {{coverSize}};
  min-height: {{coverSize}};
  max-height: {{coverSize}};
}
#CrateDeckCoverFour {
  min-width: {{coverSizeCompact}};
  max-width: {{coverSizeCompact}};
  min-height: {{coverSizeCompact}};
  max-height: {{coverSizeCompact}};
}
#CrateDeckTitle {
  qproperty-layoutSpacing: {{deckTitleGap.number}};
}
#CrateDeckTitleText,
#CrateDeckTitleTextFour {
  font-family: "{{fontBody}}";
  font-weight: {{fontWeightDeckTitle}};
  color: {{textPrimary}};
}
#CrateDeckTitleText {
  font-size: {{fontSizeDeckTitle}};
  letter-spacing: {{trackingDeckTitle * fontSizeDeckTitle}};
}
#CrateDeckTitleTextFour {
  font-size: {{fontSizeDeckTitleCompact}};
  letter-spacing: {{trackingDeckTitle * fontSizeDeckTitleCompact}};
}
#CrateDeckTitleTextFour[highlight="1"] {
  font-size: {{fontSizeDeckTitleCompactShort}};
  letter-spacing: {{trackingDeckTitle * fontSizeDeckTitleCompactShort}};
}
#CrateDeckArtistRow {
  qproperty-layoutSpacing: 0;
  qproperty-layoutAlignment: 'AlignLeft | AlignVCenter';
}
#CrateDeckArtist,
#CrateDeckArtistFour {
  font-family: "{{fontBody}}";
  font-size: {{fontSizeCaption}};
  color: {{textMuted}};
}
#CrateDeckArtistFour[highlight="1"] {
  font-size: {{fontSizeDeckArtistCompactShort}};
}
/* Packed at the bottom: a spacer above would add one more gap */
#CrateDeckNumber {
  qproperty-layoutSpacing: {{deckNumberGap.number}};
  qproperty-layoutAlignment: 'AlignBottom';
}
/* Bricolage 700 with tabular figures (C++ adds tnum and the axes) */
[objectName^="DeckNumber"] {
  font-family: "{{fontDisplay}}";
  font-weight: {{deckNumberWeight}};
  color: {{textPrimary}};
}
/* The line box is .display's 0.95 em, tighter than the font's own */
#DeckNumberBpm,
#DeckNumberTime {
  font-size: {{fontSizeDeckNumber}};
  letter-spacing: {{trackingTitle * fontSizeDeckNumber}};
  min-height: {{lineHeightDisplay * fontSizeDeckNumber}};
  max-height: {{lineHeightDisplay * fontSizeDeckNumber}};
}
#DeckNumberBpm[highlight="1"],
#DeckNumberTime[highlight="1"] {
  font-size: {{fontSizeDeckNumberNarrow}};
  letter-spacing: {{trackingTitle * fontSizeDeckNumberNarrow}};
  min-height: {{lineHeightDisplay * fontSizeDeckNumberNarrow}};
  max-height: {{lineHeightDisplay * fontSizeDeckNumberNarrow}};
}
#DeckNumberBpmFour,
#DeckNumberTimeFour {
  font-size: {{fontSizeDeckNumberCompact}};
  letter-spacing: {{trackingTitle * fontSizeDeckNumberCompact}};
  min-height: {{lineHeightDisplay * fontSizeDeckNumberCompact}};
  max-height: {{lineHeightDisplay * fontSizeDeckNumberCompact}};
}
#DeckNumberBpmFour[highlight="1"],
#DeckNumberTimeFour[highlight="1"] {
  font-size: {{fontSizeDeckNumberCompactShort}};
  letter-spacing: {{trackingTitle * fontSizeDeckNumberCompactShort}};
  min-height: {{lineHeightDisplay * fontSizeDeckNumberCompactShort}};
  max-height: {{lineHeightDisplay * fontSizeDeckNumberCompactShort}};
}

/* Overview: 40 to 88 px, the flexible row of the deck */
#CrateOverviewBox {
  min-height: {{overviewMinHeight}};
  max-height: {{overviewMaxHeight}};
}
#CrateOverviewBox[highlight="1"] {
  max-height: {{overviewMaxHeightShort}};
}
/* Four decks: 40 px at any height, as the mockups render it (.overview's
   min-height of 40 wins over the grid row's 32, and below the 768
   breakpoint over its max-height of 28) */
#CrateOverviewBoxFour,
#CrateOverviewBoxFour[highlight="1"] {
  min-height: {{overviewMinHeight}};
  max-height: {{overviewMinHeight}};
}

/* Deck menu over the overview */
#CrateDeckMenu {
  background-color: {{bgPopover}};
  border: {{strokeHairline}} solid {{border}};
  border-radius: {{radiusLg}};
  padding: {{loopGap + loopGap}};
  qproperty-layoutSpacing: {{loopGap.number}};
}

/* Transport (decks.css .tbtn): outlined; CUE in accent; play and sync
   filled in the deck colour when on */
#CrateTransport,
#CrateTransportFour,
#CrateTransportFourShort {
  qproperty-layoutSpacing: {{transportGap.number}};
}
/* The transport and the hotcues of the compact decks, apart for each size
   (deck_main_compact.xml): as tall as the deck's row gap */
#CrateDeckLowerFour {
  qproperty-layoutSpacing: {{deckRowGapShort.number}};
}
#CrateDeckLowerFourShort {
  qproperty-layoutSpacing: {{deckRowGapFourShort.number}};
}
[objectName^="MonoCue"] {
  background-color: transparent;
  border: {{strokeHairline}} solid {{accent}};
  border-radius: {{radiusMd}};
  color: {{accent}};
  min-width: {{transportButtonMinWidth - strokeHairline - strokeHairline}};
  max-width: {{transportButtonMinWidth - strokeHairline - strokeHairline}};
}
[objectName^="MonoCue"][displayValue="1"] {
  background-color: {{accentBg}};
}
#MonoCue {
  min-height: {{transportButtonHeight - strokeHairline - strokeHairline}};
  max-height: {{transportButtonHeight - strokeHairline - strokeHairline}};
}
#MonoCueFour {
  min-height: {{transportButtonHeightFour - strokeHairline - strokeHairline}};
  max-height: {{transportButtonHeightFour - strokeHairline - strokeHairline}};
}
#MonoCueFourShort {
  min-height: {{transportButtonHeightFourShort - strokeHairline - strokeHairline}};
  max-height: {{transportButtonHeightFourShort - strokeHairline - strokeHairline}};
}
[objectName^="CratePlay"] {
  background-color: transparent;
  border: {{strokeHairline}} solid {{borderSubtle}};
  border-radius: {{radiusMd}};
  image: url(skins:CrateDecks/generated/icons/play-bold_idle.svg);
  min-width: {{transportButtonMinWidth - strokeHairline - strokeHairline}};
  max-width: {{transportButtonMinWidth - strokeHairline - strokeHairline}};
  min-height: {{iconSm}};
  max-height: {{iconSm}};
}
#CratePlayAC,
#CratePlayBD {
  padding: {{transportButtonHeight - iconSm - strokeHairline - strokeHairline.half}} 0;
}
#CratePlayFourAC,
#CratePlayFourBD {
  padding: {{transportButtonHeightFour - iconSm - strokeHairline - strokeHairline.half}} 0;
}
#CratePlayFourShortAC,
#CratePlayFourShortBD {
  padding: {{transportButtonHeightFourShort - iconSm - strokeHairline - strokeHairline.half}} 0;
}
[objectName^="CratePlay"][displayValue="1"] {
  image: url(skins:CrateDecks/generated/icons/pause-bold_onaccent.svg);
}
[objectName^="CratePlay"][objectName$="AC"][displayValue="1"] {
  background-color: {{deckA}};
  border-color: {{deckA}};
}
[objectName^="CratePlay"][objectName$="BD"][displayValue="1"] {
  background-color: {{deckB}};
  border-color: {{deckB}};
}

/* Text buttons: a MonoLabel under a transparent frame */
[objectName^="MonoDeckButtonText"] {
  color: {{textSecondary}};
  border: {{strokeHairline}} solid transparent;
}
[objectName^="MonoDeckButtonTextSync"] {
  padding: 0 {{transportButtonPadding}};
  min-width: {{transportButtonMinWidth - transportButtonPadding - transportButtonPadding - strokeHairline - strokeHairline}};
}
[objectName^="MonoDeckButtonTextSmall"],
[objectName^="MonoDeckButtonTextMenu"] {
  padding: 0 {{smallButtonPadding}};
}
#MonoDeckButtonTextSyncAC,
#MonoDeckButtonTextSyncBD {
  min-height: {{transportButtonHeight - strokeHairline - strokeHairline}};
  max-height: {{transportButtonHeight - strokeHairline - strokeHairline}};
}
#MonoDeckButtonTextSyncFourAC,
#MonoDeckButtonTextSyncFourBD {
  min-height: {{transportButtonHeightFour - strokeHairline - strokeHairline}};
  max-height: {{transportButtonHeightFour - strokeHairline - strokeHairline}};
}
#MonoDeckButtonTextSyncFourShortAC,
#MonoDeckButtonTextSyncFourShortBD {
  min-height: {{transportButtonHeightFourShort - strokeHairline - strokeHairline}};
  max-height: {{transportButtonHeightFourShort - strokeHairline - strokeHairline}};
}
[objectName^="MonoDeckButtonTextSmall"],
[objectName^="MonoDeckButtonTextMenu"] {
  min-height: {{smallButtonHeight - strokeHairline - strokeHairline}};
  max-height: {{smallButtonHeight - strokeHairline - strokeHairline}};
}
/* Below the 768 breakpoint the four decks' small buttons are as tall as
   their transport */
[objectName^="MonoDeckButtonTextSmallFourShort"] {
  min-height: {{transportButtonHeightFourShort - strokeHairline - strokeHairline}};
  max-height: {{transportButtonHeightFourShort - strokeHairline - strokeHairline}};
}
[objectName^="CrateDeckButtonFrame"] {
  background-color: transparent;
  border: {{strokeHairline}} solid {{borderSubtle}};
  border-radius: {{radiusMd}};
}
/* Sync on: filled in the deck colour, text onAccent */
[objectName^="MonoDeckButtonTextSync"][highlight="1"] {
  color: {{onAccent}};
}
[objectName^="CrateDeckButtonFrameSync"][objectName$="AC"][displayValue="1"] {
  background-color: {{deckA}};
  border-color: {{deckA}};
}
[objectName^="CrateDeckButtonFrameSync"][objectName$="BD"][displayValue="1"] {
  background-color: {{deckB}};
  border-color: {{deckB}};
}
/* Small buttons and the menu lit: outline and text in the deck colour */
[objectName^="MonoDeckButtonTextSmall"][objectName$="AC"][highlight="1"],
[objectName^="MonoDeckButtonTextMenu"][objectName$="AC"][highlight="1"] {
  color: {{deckA}};
}
[objectName^="MonoDeckButtonTextSmall"][objectName$="BD"][highlight="1"],
[objectName^="MonoDeckButtonTextMenu"][objectName$="BD"][highlight="1"] {
  color: {{deckB}};
}
[objectName^="CrateDeckButtonFrameSmall"][objectName$="AC"][displayValue="1"],
[objectName^="CrateDeckButtonFrameMenu"][objectName$="AC"][displayValue="1"] {
  border-color: {{accentHiBorder}};
}
[objectName^="CrateDeckButtonFrameSmall"][objectName$="BD"][displayValue="1"],
[objectName^="CrateDeckButtonFrameMenu"][objectName$="BD"][displayValue="1"] {
  border-color: {{textPrimaryBorder}};
}

/* Hotcues as nodes: a circle of hotcueRadius in its box, hollow at rest
   and stroked in the deck colour when set. Mixxx fills a set hotcue with
   its colour; the padding leaves no content for that fill
   (background-clip), and the number is drawn over the whole button. */
#CrateHotcues,
#CrateHotcuesFour,
#CrateHotcuesFourShort {
  qproperty-layoutSpacing: {{hotcueGap.number}};
}
#CrateHotcuesInline {
  padding-left: {{hotcueInset}};
}
[objectName^="CrateCueNode"] {
  font-family: "{{fontMono}}";
  font-size: {{fontSizeBadge}};
  color: {{textFaint}};
  background-color: transparent;
  background-clip: content;
  border: {{strokeHairline}} solid {{border}};
  border-radius: {{hotcueRadius}};
  margin: {{hotcueSize - hotcueRadius - hotcueRadius.half}};
  padding: {{hotcueRadius - strokeHairline}};
  min-width: 0;
  min-height: 0;
  max-width: 0;
  max-height: 0;
}
[objectName^="CrateCueNode"][displayValue="1"],
[objectName^="CrateCueNode"][displayValue="2"] {
  color: {{textPrimary}};
}
[objectName^="CrateCueNode"][objectName$="AC"][displayValue="1"],
[objectName^="CrateCueNode"][objectName$="AC"][displayValue="2"] {
  border-color: {{deckA}};
}
[objectName^="CrateCueNode"][objectName$="BD"][displayValue="1"],
[objectName^="CrateCueNode"][objectName$="BD"][displayValue="2"] {
  border-color: {{deckB}};
}
/* Below the 768 breakpoint the four decks' nodes are 24 px boxes: the
   mockups scale the 28 px node, circle included */
[objectName^="CrateCueNodeFourShort"] {
  border-radius: {{hotcueRadiusFourShort}};
  margin: {{hotcueSizeFourShort - hotcueRadiusFourShort - hotcueRadiusFourShort.half}};
  padding: {{hotcueRadiusFourShort - strokeHairline}};
}

/* Loop group: loop size, the size, the loop, key lock and quantize */
#CrateLoop {
  qproperty-layoutSpacing: {{loopGap.number}};
}
[objectName^="CrateLoopDouble"],
[objectName^="CrateLoopToggle"] {
  background-color: transparent;
  border: {{strokeHairline}} solid {{borderSubtle}};
  border-radius: {{radiusMd}};
  padding: {{smallButtonHeight - iconSm - strokeHairline - strokeHairline.half}} {{smallButtonPadding}};
  min-width: {{iconSm}};
  max-width: {{iconSm}};
  min-height: {{iconSm}};
  max-height: {{iconSm}};
}
[objectName^="CrateLoopDoubleFourShort"],
[objectName^="CrateLoopToggleFourShort"] {
  padding: {{transportButtonHeightFourShort - iconSm - strokeHairline - strokeHairline.half}} {{smallButtonPadding}};
}
[objectName^="CrateLoopDouble"] {
  image: url(skins:CrateDecks/generated/icons/alt-arrow-right_idle.svg);
}
[objectName^="CrateLoopToggle"] {
  image: url(skins:CrateDecks/generated/icons/repeat_idle.svg);
}
[objectName^="CrateLoopToggle"][objectName$="AC"][displayValue="1"] {
  border-color: {{accentHiBorder}};
  image: url(skins:CrateDecks/generated/icons/repeat_active.svg);
}
[objectName^="CrateLoopToggle"][objectName$="BD"][displayValue="1"] {
  border-color: {{textPrimaryBorder}};
  image: url(skins:CrateDecks/generated/icons/repeat_primary.svg);
}
/* The loop size keeps LateNight's spin box geometry, whose arrows still
   change the size, but shows only its number: without the arrows' room
   Qt leaves the edit field 1 px wide */
WBeatSpinBox[objectName^="CrateLoopSize"] {
  font-family: "{{fontMono}}";
  font-size: {{fontSizeCaption}};
  color: {{textPrimary}};
  background-color: transparent;
  border-image: none;
  border-style: solid;
  border-color: transparent;
  /* the readout and the room of the hidden arrows */
  min-width: {{loopReadoutWidth + iconSm}};
  max-width: {{loopReadoutWidth + iconSm}};
  qproperty-alignment: AlignCenter;
}
/* As tall as the transport buttons of its size; Qt adds a 1 px frame to
   the spin box's content height */
WBeatSpinBox#CrateLoopSizeFour,
WBeatSpinBox#CrateLoopSizeFourShort {
  border-width: 0;
  padding: 0;
}
WBeatSpinBox#CrateLoopSizeFour {
  min-height: {{transportButtonHeightFour - strokeHairline - strokeHairline}};
  max-height: {{transportButtonHeightFour - strokeHairline - strokeHairline}};
}
WBeatSpinBox#CrateLoopSizeFourShort {
  min-height: {{transportButtonHeightFourShort - strokeHairline - strokeHairline}};
  max-height: {{transportButtonHeightFourShort - strokeHairline - strokeHairline}};
}
WBeatSpinBox[objectName^="CrateLoopSize"] QLineEdit {
  background-color: transparent;
}
WBeatSpinBox[objectName^="CrateLoopSize"]::up-button,
WBeatSpinBox[objectName^="CrateLoopSize"]::down-button {
  background-color: transparent;
  image: none;
}

/* Cue row and stems */
#CrateCueRow,
#CrateCueRowFour,
#CrateCueRowFourShort {
  qproperty-layoutSpacing: {{deckTrackGapNarrow.number}};
}
#CrateStems {
  border-top: {{strokeHairline}} solid {{borderSubtle}};
  padding-top: {{stemsPaddingTop}};
  qproperty-layoutSpacing: {{stemsGap.number}};
}
#CrateStemsRow {
  qproperty-layoutSpacing: {{stemsGap.number}};
}
#CrateStemsGrid {
  qproperty-layoutSpacing: {{stemsRowGap.number}};
}
#CrateStem {
  qproperty-layoutSpacing: {{stemGap.number}};
}
#MonoStemsLabel,
#MonoStemName,
[objectName^="MonoStemChipText"],
#MonoStemChipsLabel,
#MonoPitchLabel {
  font-size: {{fontSizeLabelSmall.fontsize}};
  letter-spacing: {{trackingCaps * fontSizeLabelSmall}};
}
#MonoStemName {
  min-width: {{stemNameMinWidth}};
}
#MonoStemName[highlight="1"] {
  color: {{textFaint}};
}
#CrateStemRail {
  min-height: {{stemRailHeight}};
  max-height: {{stemRailHeight}};
}
[objectName^="CrateStemMute"] {
  background-color: transparent;
  border: {{strokeHairline}} solid {{borderSubtle}};
  border-radius: {{radiusSm}};
  image: url(skins:CrateDecks/generated/icons/volume-cross_idle.svg);
  padding: {{muteHeight - iconXs - strokeHairline - strokeHairline.half}} {{muteWidth - iconXs - strokeHairline - strokeHairline.half}};
  min-width: {{iconXs}};
  max-width: {{iconXs}};
  min-height: {{iconXs}};
  max-height: {{iconXs}};
}
[objectName^="CrateStemMute"][displayValue="1"] {
  image: url(skins:CrateDecks/generated/icons/volume-cross_onaccent.svg);
}
#CrateStemMuteAC[displayValue="1"] {
  background-color: {{deckA}};
  border-color: {{deckA}};
}
#CrateStemMuteBD[displayValue="1"] {
  background-color: {{deckB}};
  border-color: {{deckB}};
}
#CrateStemChips,
#CrateStemChipsRow {
  qproperty-layoutSpacing: {{stemChipsGap.number}};
}
[objectName^="MonoStemChipText"] {
  color: {{textSecondary}};
  border: {{strokeHairline}} solid transparent;
  padding: 0 {{stemChipPaddingRight}} 0 {{stemChipPaddingLeft}};
  min-height: {{stemChipHeight - strokeHairline - strokeHairline}};
  max-height: {{stemChipHeight - strokeHairline - strokeHairline}};
}
[objectName^="MonoStemChipText"][highlight="1"] {
  color: {{textFaint}};
  text-decoration: line-through;
}
#CrateStemChipFrame {
  background-color: transparent;
  border: {{strokeHairline}} solid {{borderSubtle}};
  border-radius: {{radiusSm}};
}
#CrateStemChipFrame[displayValue="1"] {
  border-color: {{borderSubtle}};
}
/* Below the 1366 breakpoint the four-deck stems are a single label */
#MonoStemChipsLabel[highlight="1"] {
  border: {{strokeHairline}} solid {{borderSubtle}};
  border-radius: {{radiusSm}};
  padding: 0 {{smallButtonPadding}};
  min-height: {{stemChipHeight - strokeHairline - strokeHairline}};
  max-height: {{stemChipHeight - strokeHairline - strokeHairline}};
}

/* Phrase rule and Smart Mix line (laid out, hidden until their data) */
#CratePhrase {
  qproperty-layoutSpacing: {{phraseGap.number}};
  min-height: {{phraseHeight}};
  max-height: {{phraseHeight}};
}
#CratePhraseRuler {
  border-image: url(skins:CrateDecks/generated/controls/phrase-ruler.svg) 0 0 0 0 stretch stretch;
}
#CratePhraseText {
  font-family: "{{fontMono}}";
  font-size: {{fontSizeLabel}};
  color: {{textSecondary}};
}
#CrateNext {
  qproperty-layoutSpacing: {{deckHeadGap.number}};
  min-height: {{nextHeight}};
  max-height: {{nextHeight}};
}
#CrateNextIcon {
  image: url(skins:CrateDecks/generated/icons/stars_active.svg);
  min-width: {{iconSm}};
  max-width: {{iconSm}};
  min-height: {{iconSm}};
  max-height: {{iconSm}};
}
#CrateNextLane {
  background-color: {{border}};
  margin: {{nextHeight - strokeHairline.half}} 0;
  min-height: {{strokeHairline}};
  max-height: {{strokeHairline}};
}
#CrateNextCountdown {
  font-family: "{{fontMono}}";
  font-size: {{fontSizeLabel}};
  color: {{textPrimary}};
}

/* Pitch column (decks.css .pitch) */
#CratePitch,
#CratePitchFour {
  qproperty-layoutSpacing: {{pitchGap.number}};
  min-width: {{pitchColumnWidth}};
  max-width: {{pitchColumnWidth}};
}
[objectName^="CrateFaderPitch"] {
  min-width: {{pitchFaderWidth}};
  max-width: {{pitchFaderWidth}};
}
#CratePitchFaderBox {
  min-height: {{pitchFaderMinHeight}};
}
#CratePitchFaderBoxFour {
  min-height: {{pitchFaderMinHeightFour}};
}
#CratePitchFaderBoxFour[highlight="1"] {
  min-height: {{pitchFaderMinHeightFourShort}};
}
#CratePitchValue {
  font-family: "{{fontMono}}";
  font-size: {{fontSizeLabel}};
  color: {{textSecondary}};
}

/* ── Mixer (decks.css .mixer, design 14.3) ─────────────────────────── */

/* Padding and gaps are layout margins and spacing, which WWidgetGroup
   applies twice (half the value each time) and which follow a restyle */
#CrateMixer {
  qproperty-layoutContentsMargins: rect({{mixerPaddingX.half.number}} {{mixerPaddingTop.half.number}} {{mixerPaddingX.half.number}} {{mixerPaddingBottom.half.number}});
  qproperty-layoutSpacing: {{mixerRowGap.number}};
}
#CrateMixer[highlight="1"] {
  qproperty-layoutContentsMargins: rect({{mixerPaddingX.half.number}} {{mixerPaddingTopShort.half.number}} {{mixerPaddingX.half.number}} {{mixerPaddingBottomShort.half.number}});
}
#CrateMixerStrips {
  qproperty-layoutSpacing: {{stripGap.number}};
}
#CrateStrip,
#CrateStripFour {
  qproperty-layoutSpacing: {{stripHeadGap.number}};
}
#CrateStripBody {
  qproperty-layoutSpacing: {{stripColumnGap.number}};
}
/* Four decks: the fader 10 px under the knobs */
#CrateStripFaderRowFour {
  qproperty-layoutContentsMargins: rect(0 {{stripFaderMarginFour - stripHeadGap.half.number}} 0 0);
}

/* The deck letter of a strip */
#CrateStripLetterAC,
#CrateStripLetterBD {
  font-family: "{{fontMono}}";
  font-size: {{fontSizeStripLetter}};
  border-radius: {{radiusSm}};
  min-width: {{stripLetterSize - strokeHairline - strokeHairline}};
  max-width: {{stripLetterSize - strokeHairline - strokeHairline}};
  min-height: {{stripLetterSize - strokeHairline - strokeHairline}};
  max-height: {{stripLetterSize - strokeHairline - strokeHairline}};
}
#CrateStripLetterAC { border: {{strokeHairline}} solid {{deckA}}; color: {{deckA}}; }
#CrateStripLetterBD { border: {{strokeHairline}} solid {{deckB}}; color: {{deckB}}; }

/* Knobs (decks.css .knob): 36 px, 30 below the 768 breakpoint; 30 and 26
   with four decks. The arc radius of each size is in generated/vars.xml */
#CrateStripKnobs {
  qproperty-layoutSpacing: {{knobGap.number}};
}
#CrateStripKnobs[highlight="1"] {
  qproperty-layoutSpacing: {{knobGapShort.number}};
}
#CrateStripKnobsFour {
  qproperty-layoutSpacing: {{knobGapFour.number}};
}
#CrateKnobBox {
  qproperty-layoutSpacing: {{knobLabelGap.number}};
}
#CrateKnob {
  min-width: {{knobSize}};
  max-width: {{knobSize}};
  min-height: {{knobSize}};
  max-height: {{knobSize}};
}
#CrateKnobShort,
#CrateKnobFour {
  min-width: {{knobSizeCompact}};
  max-width: {{knobSizeCompact}};
  min-height: {{knobSizeCompact}};
  max-height: {{knobSizeCompact}};
}
#CrateKnobFourShort {
  min-width: {{knobSizeFourShort}};
  max-width: {{knobSizeFourShort}};
  min-height: {{knobSizeFourShort}};
  max-height: {{knobSizeFourShort}};
}
/* MonoLabel of 9.5 px (9 below the 768 breakpoint), one line high */
#MonoKnobLabel {
  font-size: {{fontSizeLabelSmall.fontsize}};
  letter-spacing: {{trackingCaps * fontSizeLabelSmall}};
  min-height: {{fontSizeLabelSmall}};
  max-height: {{fontSizeLabelSmall}};
}
#MonoKnobLabel[highlight="1"] {
  font-size: {{fontSizeLegend.fontsize}};
  letter-spacing: {{trackingCaps * fontSizeLegend}};
  min-height: {{fontSizeLegend}};
  max-height: {{fontSizeLegend}};
}

/* Meter and fader of a strip, and the headphone button under them */
#CrateStripFader,
#CrateStripFaderFour {
  qproperty-layoutSpacing: {{stripFaderGap.number}};
}
#CrateStripMeterFader {
  qproperty-layoutSpacing: {{vuGap.number}};
}
[objectName^="CrateFaderChannel"] {
  min-width: {{faderWidth}};
  max-width: {{faderWidth}};
}
#CrateFaderCross {
  min-height: {{faderWidth}};
  max-height: {{faderWidth}};
}
/* The colour that fills a fader's handle while it moves or syncs, and
   lights a meter (crate/ui/skin/mixerstyle.cpp) */
[objectName^="CrateFader"][objectName$="AC"],
#CrateMeterVuAC {
  color: {{deckA}};
}
[objectName^="CrateFader"][objectName$="BD"],
#CrateMeterVuBD {
  color: {{deckB}};
}
#CrateFaderCross,
#CrateMeterVuMain {
  color: {{vuLevel}};
}
#CrateMeterLane {
  color: {{accentHi}};
}

/* Level meters (decks.css .vu): the clip segment over a 4 px bar */
#CrateVu,
#CrateVuClip,
[objectName^="CrateMeterVu"] {
  min-width: {{vuBarWidth}};
  max-width: {{vuBarWidth}};
}
#CrateVuClip {
  background-color: {{vuClipTrack}};
  min-height: {{vuClipHeight}};
  max-height: {{vuClipHeight}};
}
#CrateVuClip[highlight="1"] {
  background-color: {{vuClip}};
}

/* Headphones (decks.css .tbtn[data-small]): outlined, filled in the deck
   colour when on */
[objectName^="CratePfl"] {
  background-color: transparent;
  border: {{strokeHairline}} solid {{border}};
  border-radius: {{radiusMd}};
  image: url(skins:CrateDecks/generated/icons/headphones-round-sound_idle.svg);
  min-width: {{iconSm + smallButtonPadding + smallButtonPadding}};
  max-width: {{iconSm + smallButtonPadding + smallButtonPadding}};
  min-height: {{iconSm}};
  max-height: {{iconSm}};
}
#CratePflAC, #CratePflBD,
#CratePflShortAC, #CratePflShortBD {
  padding: {{smallButtonHeight - iconSm - strokeHairline - strokeHairline.half}} 0;
}
#CratePflFourAC, #CratePflFourBD {
  padding: {{transportButtonHeightFour - iconSm - strokeHairline - strokeHairline.half}} 0;
}
#CratePflFourShortAC, #CratePflFourShortBD {
  padding: {{transportButtonHeightFourShort - iconSm - strokeHairline - strokeHairline.half}} 0;
}
[objectName^="CratePfl"][displayValue="1"] {
  image: url(skins:CrateDecks/generated/icons/headphones-round-sound_onaccent.svg);
}
[objectName^="CratePfl"][objectName$="AC"][displayValue="1"] {
  background-color: {{deckA}};
  border-color: {{deckA}};
}
[objectName^="CratePfl"][objectName$="BD"][displayValue="1"] {
  background-color: {{deckB}};
  border-color: {{deckB}};
}

/* Main and headphones (decks.css .master) */
/* Packed at the top, as the grid of .master: a spacer would add a gap */
#CrateMaster {
  qproperty-layoutContentsMargins: rect({{masterPaddingX.half.number}} 0 {{masterPaddingX.half.number}} 0);
  qproperty-layoutSpacing: {{masterGap.number}};
  qproperty-layoutAlignment: 'AlignTop';
}
#CrateMasterVus {
  qproperty-layoutSpacing: {{masterVuGap.number}};
  min-height: {{masterVuHeight}};
  max-height: {{masterVuHeight}};
}
#CrateMasterVus[highlight="1"] {
  min-height: {{masterVuHeightShort}};
  max-height: {{masterVuHeightShort}};
}

/* Crossfader (decks.css .xfader) */
#CrateCrossfader {
  qproperty-layoutSpacing: {{xfaderGap.number}};
}

/* Empty deck: drop zone */
#CrateDropZone {
  border: {{strokeHairline}} dashed {{border}};
  border-radius: {{radiusLg}};
  qproperty-layoutSpacing: {{dropZoneGap.number}};
}
#CrateDropIcon {
  image: url(skins:CrateDecks/generated/icons/vinyl-record_disabled.svg);
  min-width: {{dropIconSize}};
  max-width: {{dropIconSize}};
  min-height: {{dropIconSize}};
  max-height: {{dropIconSize}};
}
#CrateDropText {
  qproperty-layoutSpacing: {{dropZoneTextGap.number}};
}
#CrateDropTitle {
  font-family: "{{fontBody}}";
  font-size: {{fontSizeDropTitle}};
  color: {{textMuted}};
}

/* ── Library (decks.css .lib, plan V2.PR4) ────────────────────────────── */

/* C++ paints what QSS cannot (crate/ui/skin/librarystyle.cpp and
   crate/ui/delegates/): the sidebar's items and section headers, the
   table's rows, rules, hover and selection, its MonoLabel column headers,
   the deck letters of loaded tracks and the cells. QSS lays the library out
   and clears what Qt would paint on its own. No rule here styles ::item,
   which is what costs most when a table scrolls (plan V2, performance). */
#CrateLibrary {
  background-color: {{bgApp}};
  qproperty-layoutSpacing: 0;
}
#CrateLibraryMain {
  qproperty-layoutSpacing: 0;
}

/* Sidebar: 240 px with its 1 px rule, as the admin's navigation */
#CrateSidebar {
  min-width: {{sidebarWidth - strokeHairline}};
  max-width: {{sidebarWidth - strokeHairline}};
}
#CrateSidebarRule {
  background-color: {{borderSubtle}};
  min-width: {{strokeHairline}};
  max-width: {{strokeHairline}};
}
#CrateLibrary WLibrarySidebar {
  background-color: {{bgApp}};
  border: 0;
  outline: none;
  padding: {{sidebarPaddingTop}} 0 {{sidebarPaddingBottom}} 0;
  selection-background-color: transparent;
  show-decoration-selected: 0;
}

/* Search row: 44 px, 40 below the 768 breakpoint, with its rule; the
   search field has no background of its own */
#CrateSearchRow {
  min-height: {{heightSearchTall - strokeHairline}};
  max-height: {{heightSearchTall - strokeHairline}};
}
#CrateSearchRow[highlight="1"] {
  min-height: {{heightSearch - strokeHairline}};
  max-height: {{heightSearch - strokeHairline}};
}
#CrateSearchRowInner {
  qproperty-layoutContentsMargins: rect({{gutter.half.number}} 0 {{gutter.half.number}} 0);
  qproperty-layoutSpacing: {{searchGap.number}};
}
#CrateSearchRowInner[highlight="1"] {
  qproperty-layoutContentsMargins: rect({{gutterNarrow.half.number}} 0 {{gutterNarrow.half.number}} 0);
}
#CrateSearchQuery {
  qproperty-layoutSpacing: {{searchIconGap.number}};
}
#CrateSearchRule {
  background-color: {{border}};
  min-height: {{strokeHairline}};
  max-height: {{strokeHairline}};
}
#CrateSearchIcon {
  image: url(skins:CrateDecks/generated/icons/magnifier_idle.svg);
  min-width: {{iconMd}};
  max-width: {{iconMd}};
  min-height: {{iconMd}};
  max-height: {{iconMd}};
}
#CrateLibrary WSearchLineEdit,
#CrateLibrary WSearchLineEdit QLineEdit {
  font-family: "{{fontMono}}";
  font-size: {{fontSizeCaption}};
  color: {{textPrimary}};
  background-color: transparent;
  border: 0;
  margin: 0;
  padding: 0;
  selection-color: {{onAccent}};
  selection-background-color: {{accentHi}};
}
/* No arrow for the search history, which opens with the down key */
#CrateLibrary WSearchLineEdit::drop-down,
#CrateLibrary WSearchLineEdit::down-arrow {
  width: 0;
  border: 0;
  image: none;
}
#CrateLibrary WSearchLineEdit QToolButton {
  image: url(skins:CrateDecks/generated/icons/close-circle_idle.svg);
  background-color: transparent;
  border: 0;
}
#CrateLibrary WSearchLineEdit QToolButton:hover {
  image: url(skins:CrateDecks/generated/icons/close-circle_hover.svg);
}
#TbIconMaximize { image: url(skins:CrateDecks/generated/icons/maximize_idle.svg); }
#TbIconMaximize:hover { image: url(skins:CrateDecks/generated/icons/maximize_hover.svg); }
#TbIconMaximize[displayValue="1"] {
  image: url(skins:CrateDecks/generated/icons/maximize_active.svg);
  border-color: transparent;
  background-color: transparent;
}

/* Track table: "cabin" density, a list with 1 px rules and no zebra or
   boxes (design 14.3). The view's text colour is that of names; C++ gives
   titles, BPM, key and duration their own. Mixxx colours the text of played
   and missing tracks with these properties. */
#CrateLibrary WTrackTableView {
  font-family: "{{fontBody}}";
  font-size: {{fontSizeCaption}};
  color: {{textMuted}};
  background-color: {{bgApp}};
  alternate-background-color: {{bgApp}};
  selection-color: {{textPrimary}};
  selection-background-color: transparent;
  border: 0;
  outline: none;
  qproperty-alternatingRowColors: false;
  qproperty-showGrid: false;
  qproperty-focusBorderColor: transparent;
  qproperty-trackPlayedColor: {{textSubtle}};
  qproperty-trackMissingColor: {{warningText}};
  qproperty-dropIndicatorColor: {{accentHi}};
}
/* C++ paints the column headers as MonoLabels; QSS gives the header its
   font, which Mixxx also measures it with */
#CrateLibrary WTrackTableViewHeader,
#CrateLibrary WTrackTableViewHeader::section {
  font-family: "{{fontMono}}";
  font-size: {{fontSizeMeta.fontsize}};
  text-transform: uppercase;
  letter-spacing: {{trackingCaps * fontSizeMeta}};
  color: {{textSubtle}};
  background-color: {{bgApp}};
  border: 0;
  padding: 0;
}
#CrateLibrary QAbstractScrollArea::corner,
#CrateLibrary WTrackTableView QHeaderView {
  background-color: {{bgApp}};
  border: 0;
}
/* The corner over the deck letters carries on the header's rule */
#CrateLibrary QTableCornerButton::section {
  background-color: {{bgApp}};
  border: 0;
  border-bottom: {{strokeHairline}} solid {{border}};
}

/* Cell editors */
#CrateLibrary WTrackTableView QLineEdit,
#CrateLibrary WTrackTableView QPlainTextEdit,
#CrateLibrary WTrackTableView QDoubleSpinBox {
  font-family: "{{fontBody}}";
  font-size: {{fontSizeCaption}};
  color: {{textPrimary}};
  background-color: {{bgPopover}};
  border: {{strokeHairline}} solid {{accentBorderFocus}};
  border-radius: {{radiusSm}};
  selection-color: {{onAccent}};
  selection-background-color: {{accentHi}};
}

/* Scroll bars of 8 px, a rounded thumb on no track (typography.css) */
#CrateLibrary QScrollBar:vertical {
  background-color: transparent;
  border: 0;
  margin: 0;
  width: {{scrollbarWidth}};
}
#CrateLibrary QScrollBar:horizontal {
  background-color: transparent;
  border: 0;
  margin: 0;
  height: {{scrollbarWidth}};
}
#CrateLibrary QScrollBar::handle {
  background-color: {{scrollbarThumb}};
  border: 0;
  border-radius: {{radiusMd}};
}
#CrateLibrary QScrollBar::handle:vertical {
  min-height: {{heightControlXs}};
}
#CrateLibrary QScrollBar::handle:horizontal {
  min-width: {{heightControlXs}};
}
#CrateLibrary QScrollBar::handle:hover {
  background-color: {{scrollbarHover}};
}
#CrateLibrary QScrollBar::add-line,
#CrateLibrary QScrollBar::sub-line {
  width: 0;
  height: 0;
  border: 0;
  background: none;
}
#CrateLibrary QScrollBar::add-page,
#CrateLibrary QScrollBar::sub-page {
  background: none;
}

    readonly property real motionNormal: {{motionNormal}}
    readonly property string motionEaseSnap: "{{motionEaseSnap}}"

    // iconSize
    readonly property real iconNano: {{iconNano}}
    readonly property real iconMicro: {{iconMicro}}
    readonly property real iconXs: {{iconXs}}
    readonly property real iconSm: {{iconSm}}
    readonly property real iconMd: {{iconMd}}
    readonly property real iconLg: {{iconLg}}

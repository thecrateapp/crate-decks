    readonly property real fontSizeLegend: {{fontSizeLegend}}
    readonly property real fontSizeTable: {{fontSizeTable}}
    readonly property real fontSizeDeckNumber: {{fontSizeDeckNumber}}
    readonly property real fontSizeDeckNumberCompact: {{fontSizeDeckNumberCompact}}
    readonly property real fontSizeBrand: {{fontSizeBrand}}
    readonly property real fontSizeDeckNumberNarrow: {{fontSizeDeckNumberNarrow}}
    readonly property real fontSizeDeckNumberCompactShort: {{fontSizeDeckNumberCompactShort}}

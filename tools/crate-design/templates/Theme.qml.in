// Crate Decks design tokens for QML (stage 2, design section 14.4).
// Template for tools/crate-design/generate.py: every token in
// res/crate-design/tokens.json has a property here. Lengths are in pixels,
// tracking in em, durations in milliseconds and sweeps in degrees.
pragma Singleton
import QtQuick 2.12

QtObject {
    // color
    readonly property color bgApp: "{{bgApp}}"
    readonly property color bgPanel: "{{bgPanel}}"
    readonly property color bgRaised: "{{bgRaised}}"
    readonly property color bgPopover: "{{bgPopover}}"
    readonly property color bgSecondary: "{{bgSecondary}}"

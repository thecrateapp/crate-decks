    readonly property color textPrimary: "{{textPrimary}}"
    readonly property color textSecondary: "{{textSecondary}}"
    readonly property color textMuted: "{{textMuted}}"
    readonly property color textSubtle: "{{textSubtle}}"
    readonly property color textFaint: "{{textFaint}}"
    readonly property color navIdle: "{{navIdle}}"
    readonly property color accent: "{{accent}}"
    readonly property color onAccent: "{{onAccent}}"

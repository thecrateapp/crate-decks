// Crate Decks design tokens for QML (stage 2, design section 14.4).
// Template for tools/crate-design/generate.py: every token in
// res/crate-design/tokens.json has a property here. Lengths are in pixels,
// tracking in em, durations in milliseconds and sweeps in degrees.
pragma Singleton
import QtQuick 2.12

QtObject {
    // color
    readonly property color bgApp: "{{bgApp}}"
    readonly property color bgPanel: "{{bgPanel}}"
    readonly property color bgRaised: "{{bgRaised}}"
    readonly property color bgPopover: "{{bgPopover}}"
    readonly property color bgSecondary: "{{bgSecondary}}"
    readonly property color border: "{{border}}"
    readonly property color borderSubtle: "{{borderSubtle}}"
    readonly property color borderHover: "{{borderHover}}"
    readonly property color hoverBg: "{{hoverBg}}"
    readonly property color hoverBgStrong: "{{hoverBgStrong}}"
    readonly property color scrollbarThumb: "{{scrollbarThumb}}"
    readonly property color scrollbarHover: "{{scrollbarHover}}"
    readonly property color textPrimary: "{{textPrimary}}"
    readonly property color textSecondary: "{{textSecondary}}"
    readonly property color textMuted: "{{textMuted}}"
    readonly property color textSubtle: "{{textSubtle}}"
    readonly property color textFaint: "{{textFaint}}"
    readonly property color navIdle: "{{navIdle}}"
    readonly property color accent: "{{accent}}"
    readonly property color onAccent: "{{onAccent}}"
    readonly property color accentHi: "{{accentHi}}"
    readonly property color accentBg: "{{accentBg}}"
    readonly property color accentBorder: "{{accentBorder}}"
    readonly property color accentBorderFocus: "{{accentBorderFocus}}"
    readonly property color rowHover: "{{rowHover}}"
    readonly property color rowSelected: "{{rowSelected}}"
    readonly property color focusRing: "{{focusRing}}"
    readonly property color warning: "{{warning}}"
    readonly property color warningText: "{{warningText}}"
    readonly property color danger: "{{danger}}"
    readonly property color dangerText: "{{dangerText}}"
    readonly property color logoStart: "{{logoStart}}"
    readonly property color logoEnd: "{{logoEnd}}"
    readonly property color logoShade: "{{logoShade}}"
    readonly property color accentHiBorder: "{{accentHiBorder}}"
    readonly property color textPrimaryBorder: "{{textPrimaryBorder}}"

    // iconState
    readonly property color iconIdle: "{{iconIdle}}"
    readonly property color iconHover: "{{iconHover}}"
    readonly property color iconActive: "{{iconActive}}"
    readonly property color iconDisabled: "{{iconDisabled}}"
    readonly property color iconOnAccent: "{{iconOnAccent}}"
    readonly property color iconPrimary: "{{iconPrimary}}"

    // deck
    readonly property color deckA: "{{deckA}}"
    readonly property color deckB: "{{deckB}}"
    readonly property color deckC: "{{deckC}}"
    readonly property color deckD: "{{deckD}}"

    // waveform
    readonly property color waveBg: "{{waveBg}}"
    readonly property color waveLowAccent: "{{waveLowAccent}}"
    readonly property color waveMidAccent: "{{waveMidAccent}}"
    readonly property color waveHighAccent: "{{waveHighAccent}}"
    readonly property color waveLowNeutral: "{{waveLowNeutral}}"
    readonly property color waveMidNeutral: "{{waveMidNeutral}}"
    readonly property color waveHighNeutral: "{{waveHighNeutral}}"
    readonly property color wavePlayhead: "{{wavePlayhead}}"
    readonly property color waveBeat: "{{waveBeat}}"
    readonly property color waveDownbeat: "{{waveDownbeat}}"
    readonly property color waveOverviewBg: "{{waveOverviewBg}}"
    readonly property color waveOverviewPlayed: "{{waveOverviewPlayed}}"
    // "Accent" (logo bands) or "Neutral" (the reserve: greys on every deck)
    readonly property string wavePaletteDeckAC: "{{wavePaletteDeckAC}}"
    readonly property color waveLowDeckAC: "{{waveLowDeckAC}}"
    readonly property color waveMidDeckAC: "{{waveMidDeckAC}}"
    readonly property color waveHighDeckAC: "{{waveHighDeckAC}}"
    readonly property color waveLowDeckBD: "{{waveLowDeckBD}}"
    readonly property color waveMidDeckBD: "{{waveMidDeckBD}}"
    readonly property color waveHighDeckBD: "{{waveHighDeckBD}}"

    // meter

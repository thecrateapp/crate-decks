#!/bin/sh
# Sets the sustained CPU package power limit (PL1) that the firmware exposes
# through MMIO RAPL. Some laptop firmware holds it far below what the
# processor can sustain (20 W on a Dell XPS 16 9640), which throttles the
# integrated GPU that composites the desktop to a fifth of its clock. On AC it
# is raised; on battery it goes back to the firmware's value.
#   CRATE_PL1_AC_WATTS (default 45), CRATE_PL1_BATTERY_WATTS (default 20),
#   both read from /etc/default/crate-power-limit by the service
#   CRATE_POWER_SYSFS (default /sys/class), for tests
set -eu
sysfs=${CRATE_POWER_SYSFS:-/sys/class}
limit="$sysfs/powercap/intel-rapl-mmio:0/constraint_0_power_limit_uw"
ac_watts=${CRATE_PL1_AC_WATTS:-45}
battery_watts=${CRATE_PL1_BATTERY_WATTS:-20}

[ -w "$limit" ] || { echo "crate-power-limit: $limit is missing or not writable" >&2; exit 0; }

on_ac=0
for supply in "$sysfs"/power_supply/*; do
    [ "$(cat "$supply/type" 2>/dev/null)" = Mains ] || continue
    [ "$(cat "$supply/online" 2>/dev/null)" = 1 ] && on_ac=1
done

if [ "$on_ac" = 1 ]; then watts=$ac_watts; else watts=$battery_watts; fi
echo $((watts * 1000000)) > "$limit"
echo "crate-power-limit: PL1 set to ${watts} W ($( [ "$on_ac" = 1 ] && echo AC || echo battery))"

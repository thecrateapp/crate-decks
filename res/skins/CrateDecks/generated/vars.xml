  <SetVariable name="CrateDlgPrefsIntroGap">22</SetVariable>
  <SetVariable name="CrateDlgPrefsIntroMaxWidth">680</SetVariable>
  <SetVariable name="CrateDlgPrefsSectionPaddingTop">18</SetVariable>
  <SetVariable name="CrateDlgPrefsSectionPaddingBottom">20</SetVariable>
  <SetVariable name="CrateDlgPrefsSectionLabelGap">12</SetVariable>
  <SetVariable name="CrateDlgPrefsRowLabelWidth">220</SetVariable>
  <SetVariable name="CrateDlgPrefsRowLabelWidthColumn">96</SetVariable>
  <SetVariable name="CrateDlgPrefsRowGap">18</SetVariable>
  <SetVariable name="CrateDlgPrefsColumnGap">40</SetVariable>
  <SetVariable name="CrateDlgPrefsHintGap">2</SetVariable>
  <SetVariable name="CrateDlgServerGap">14</SetVariable>
  <SetVariable name="CrateDlgServerPaddingY">12</SetVariable>
  <SetVariable name="CrateDlgServerNameGap">3</SetVariable>

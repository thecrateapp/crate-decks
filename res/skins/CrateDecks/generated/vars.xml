  <SetVariable name="CrateDlgDialogLogoHeight">17</SetVariable>
  <SetVariable name="CrateDlgIconButtonSize">32</SetVariable>
  <SetVariable name="CrateDlgPrefsWidth">1180</SetVariable>
  <SetVariable name="CrateDlgPrefsHeight">940</SetVariable>
  <SetVariable name="CrateDlgPrefsNavWidth">232</SetVariable>
  <SetVariable name="CrateDlgPrefsNavPaddingY">10</SetVariable>
  <SetVariable name="CrateDlgPrefsNavRowHeight">32</SetVariable>
  <SetVariable name="CrateDlgPrefsNavLogoWidth">15</SetVariable>
  <SetVariable name="CrateDlgPrefsNavLogoHeight">16</SetVariable>
  <SetVariable name="CrateDlgPrefsPagePaddingY">22</SetVariable>
  <SetVariable name="CrateDlgPrefsPagePaddingX">36</SetVariable>
  <SetVariable name="CrateDlgFontWeightPrefsTitle">600</SetVariable>
  <SetVariable name="CrateDlgTrackingPrefsTitle">-0.04</SetVariable>

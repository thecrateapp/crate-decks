  <SetVariable name="CrateLibStateGap">6</SetVariable>
  <SetVariable name="CrateLibChipHeight">20</SetVariable>
  <SetVariable name="CrateLibChipPadding">7</SetVariable>
  <SetVariable name="CrateLibSmallIcon">12</SetVariable>
  <!-- The Auto DJ and Analyze bars: the library's gutter, the buttons'
       height inside the 44 px row and their gap -->
  <SetVariable name="CrateLibBarGutter">20</SetVariable>
  <SetVariable name="CrateLibBarPadding">6</SetVariable>
  <SetVariable name="CrateLibBarGap">8</SetVariable>
  <SetVariable name="CrateSidebarItemInset">8</SetVariable>
  <SetVariable name="CrateSidebarItemPadding">10</SetVariable>
  <SetVariable name="CrateSidebarIndent">20</SetVariable>
  <SetVariable name="CrateSidebarIcon">16</SetVariable>
  <SetVariable name="CrateSidebarIconGap">8</SetVariable>
  <SetVariable name="CrateSidebarBarInset">6</SetVariable>
  <SetVariable name="CrateSidebarSectionTop">14</SetVariable>
  <SetVariable name="CrateSidebarSectionX">16</SetVariable>
  <SetVariable name="CrateSidebarSectionBottom">6</SetVariable>

  <!-- Dialogs, Preferences, first start and About (crate/ui/dialogs/):
       the sizes C++ lays out with; QSS (generated/default.qss) has the rest -->
  <!-- What dims the main window behind a blocking dialog (DialogScrim) -->
  <SetVariable name="CrateScrim">#b80a0a0f</SetVariable>
  <SetVariable name="CrateDlgDialogTitleHeight">44</SetVariable>
  <SetVariable name="CrateDlgDialogPaddingX">16</SetVariable>
  <SetVariable name="CrateDlgDialogFootPaddingY">12</SetVariable>

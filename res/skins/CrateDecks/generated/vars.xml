<!--
  Crate Decks skin variables, from res/crate-design/tokens.json.
  Template for tools/crate-design/generate.py. Colours are #rrggbb, or
  #aarrggbb when they have alpha; lengths are in pixels.

  A <Template> keeps its variables to itself, so skin.xml instantiates this
  file and this file instantiates the layout of the skin (main.xml) at its
  end: every template of the skin then sees these variables. C++ reads the
  layout breakpoints from here too (crate/ui/skin/).
-->
<Template>
  <!-- Surfaces and text -->
  <SetVariable name="CrateBgApp">#0a0a0f</SetVariable>
  <SetVariable name="CrateBgPanel">#0d0e14</SetVariable>
  <SetVariable name="CrateBgRaised">#0f1016</SetVariable>
  <SetVariable name="CrateBorder">#1af1f5f9</SetVariable>
  <SetVariable name="CrateTextPrimary">#f1f5f9</SetVariable>
  <SetVariable name="CrateTextMuted">#999ca0</SetVariable>
  <SetVariable name="CrateTextSubtle">#7e8084</SetVariable>
  <SetVariable name="CrateAccent">#06b6d4</SetVariable>
  <SetVariable name="CrateAccentHi">#67e8f9</SetVariable>
  <SetVariable name="CrateWarning">#fbbf24</SetVariable>
  <SetVariable name="CrateDanger">#ef4444</SetVariable>

  <!-- Fonts -->
  <SetVariable name="CrateFontBody">Roboto</SetVariable>
  <SetVariable name="CrateFontDisplay">Bricolage Grotesque</SetVariable>
  <SetVariable name="CrateFontMono">JetBrains Mono</SetVariable>
  <SetVariable name="CrateDeckNumberFont">Bricolage Grotesque</SetVariable>
  <SetVariable name="CrateDeckNumberWeight">700</SetVariable>
  <SetVariable name="CrateDeckNumberSize">34</SetVariable>
  <SetVariable name="CrateDeckNumberSizeCompact">26</SetVariable>
  <SetVariable name="CrateHotcueRadius">10</SetVariable>

  <!-- Deck colours (design 14.3): A and C cyan, B and D cold white -->
  <SetVariable name="CrateDeckA">#67e8f9</SetVariable>
  <SetVariable name="CrateDeckB">#f1f5f9</SetVariable>
  <SetVariable name="CrateDeckC">#67e8f9</SetVariable>
  <SetVariable name="CrateDeckD">#f1f5f9</SetVariable>
  <SetVariable name="CrateDeckAC">#67e8f9</SetVariable>
  <SetVariable name="CrateDeckBD">#f1f5f9</SetVariable>

  <!-- Waveforms and overviews -->
  <SetVariable name="CrateWaveBg">#0a0a0f</SetVariable>
  <SetVariable name="CrateWaveLowAccent">#0e7490</SetVariable>
  <!-- The four stems of Crate's separation, in the sidecar's order. C++
       reads them from here (crate/ui/skin/stemcolors.cpp) for the stem
       files Decks writes and the stems it shows -->
  <SetVariable name="CrateStemDrums">#67e8f9</SetVariable>
  <SetVariable name="CrateStemBass">#0e7490</SetVariable>
  <SetVariable name="CrateStemOther">#999ca0</SetVariable>
  <SetVariable name="CrateStemVocals">#fbbf24</SetVariable>
  <SetVariable name="CrateWaveMidAccent">#06b6d4</SetVariable>
  <SetVariable name="CrateWaveHighAccent">#67e8f9</SetVariable>
  <SetVariable name="CrateWaveLowNeutral">#4a4c52</SetVariable>
  <SetVariable name="CrateWaveMidNeutral">#999ca0</SetVariable>
  <SetVariable name="CrateWaveHighNeutral">#f1f5f9</SetVariable>
  <SetVariable name="CrateWavePlayhead">#f1f5f9</SetVariable>
  <SetVariable name="CrateWaveBeat">#33f1f5f9</SetVariable>
  <SetVariable name="CrateWaveDownbeat">#66f1f5f9</SetVariable>
  <SetVariable name="CrateWaveOverviewBg">#0d0e14</SetVariable>
  <SetVariable name="CrateWaveOverviewPlayed">#8c0a0a0f</SetVariable>
  <!-- Bands per deck pair: wavePaletteDeckAC picks the logo bands
       (Accent) or the reserve greys for decks A and C -->
  <SetVariable name="CrateWaveLowAC">#0e7490</SetVariable>
  <SetVariable name="CrateWaveMidAC">#06b6d4</SetVariable>
  <SetVariable name="CrateWaveHighAC">#67e8f9</SetVariable>
  <SetVariable name="CrateWaveLowBD">#4a4c52</SetVariable>
  <SetVariable name="CrateWaveMidBD">#999ca0</SetVariable>
  <SetVariable name="CrateWaveHighBD">#f1f5f9</SetVariable>

  <!-- Level meters (crate/ui/skin/mixerstyle.cpp paints them): the deck
       colour, warning from vuWarningDb on Mixxx's meter scale
       (CrateVuWarningLevel), a 1 px peak hold -->
  <SetVariable name="CrateVuLevel">#67e8f9</SetVariable>
  <SetVariable name="CrateVuWarning">#fbbf24</SetVariable>
  <SetVariable name="CrateVuClip">#ef4444</SetVariable>
  <SetVariable name="CrateVuTrack">#0ff1f5f9</SetVariable>
  <SetVariable name="CrateVuClipTrack">#2eef4444</SetVariable>
  <SetVariable name="CrateVuWarningDb">-6</SetVariable>
  <SetVariable name="CrateVuWarningLevel">0.7412</SetVariable>
  <SetVariable name="CrateVuWarningRule">#0a0a0f</SetVariable>
  <SetVariable name="CrateVuBarWidth">4</SetVariable>
  <SetVariable name="CrateVuClipGap">2</SetVariable>
  <SetVariable name="CrateVuPeakHold">1</SetVariable>
  <SetVariable name="CrateVuPeakHoldTime">500</SetVariable>
  <SetVariable name="CrateVuPeakFallTime">1000</SetVariable>
  <SetVariable name="CrateLaneTrack">#1af1f5f9</SetVariable>

  <!-- Knobs: knob-scale.svg and knob-dot.svg are drawn on a canvas of
       40 px that each knob stretches; the arc of WKnobComposed
       runs on the ring, so its radius follows the knob size. The arc takes
       the colour of the deck (CrateDeckAC and CrateDeckBD) -->
  <SetVariable name="CrateKnobSize">36</SetVariable>
  <SetVariable name="CrateKnobSizeCompact">30</SetVariable>
  <SetVariable name="CrateKnobSizeFourShort">26</SetVariable>
  <SetVariable name="CrateKnobArcRadius">12.15</SetVariable>
  <SetVariable name="CrateKnobArcRadiusCompact">10.125</SetVariable>
  <SetVariable name="CrateKnobArcRadiusFourShort">8.775</SetVariable>
  <SetVariable name="CrateKnobArcColor">#67e8f9</SetVariable>
  <SetVariable name="CrateKnobArcWidth">1.5</SetVariable>
  <SetVariable name="CrateKnobHalfSweep">135</SetVariable>
  <SetVariable name="CrateKnobSweep">270</SetVariable>

  <!-- Faders: the handle is fader-handle-*.svg; crate/ui/skin/mixerstyle.cpp
       paints the rail and ticks at the fader's real length and fills the
       handle in the fader's colour while it moves or syncs -->
  <SetVariable name="CrateFaderRail">1</SetVariable>
  <SetVariable name="CrateFaderRailColor">#33f1f5f9</SetVariable>
  <SetVariable name="CrateFaderTickColor">#4a4c52</SetVariable>
  <SetVariable name="CrateFaderCentreTickColor">#999ca0</SetVariable>
  <SetVariable name="CrateFaderTickStep">10</SetVariable>
  <SetVariable name="CrateFaderTickGap">2</SetVariable>
  <SetVariable name="CrateFaderTickLong">7</SetVariable>
  <SetVariable name="CrateFaderTickShort">3</SetVariable>
  <SetVariable name="CrateFaderHandleWidth">18</SetVariable>
  <SetVariable name="CrateFaderHandleHeight">10</SetVariable>
  <SetVariable name="CrateFaderHandleLength">11</SetVariable>
  <SetVariable name="CrateFaderHandleLine">8</SetVariable>
  <SetVariable name="CrateFaderHandleRadius">2</SetVariable>
  <SetVariable name="CrateFaderHandleLineActive">#0a0a0f</SetVariable>
  <SetVariable name="CrateFaderActiveHold">250</SetVariable>
  <SetVariable name="CrateFaderWidth">30</SetVariable>
  <SetVariable name="CratePitchFaderWidth">34</SetVariable>

  <!-- Layout: the 1366 x 768 breakpoints of the GU1 mockups (C++ sets
       [CrateDecks],layout_narrow and layout_short from them) -->
  <SetVariable name="CrateLayoutNarrowBelow">1500</SetVariable>
  <SetVariable name="CrateLayoutShortBelow">800</SetVariable>
  <!-- Toolbar readings -->
  <SetVariable name="CrateReadingMinWidth">64</SetVariable>
  <SetVariable name="CrateLaneMeter">1</SetVariable>

  <!-- Cache and download level ring -->
  <SetVariable name="CrateLevelRingRadius">7</SetVariable>
  <SetVariable name="CrateLevelRingWidth">1.5</SetVariable>
  <SetVariable name="CrateLevelRingTrackWidth">1</SetVariable>
  <SetVariable name="CrateLevelRingMinimum">0.04</SetVariable>

  <!-- Library: crate/ui/delegates/ paints its cells and its sidebar, and
       crate/ui/skin/librarystyle.cpp its rows, column headers and deck
       letters (GU1 mockups decks.css .tracks and .side) -->
  <SetVariable name="CrateTextSecondary">#c7f1f5f9</SetVariable>
  <SetVariable name="CrateTextFaint">#4a4c52</SetVariable>
  <SetVariable name="CrateNavIdle">#6bffffff</SetVariable>
  <SetVariable name="CrateBorderSubtle">#0ff1f5f9</SetVariable>
  <SetVariable name="CrateRowHover">#0a06b6d4</SetVariable>
  <SetVariable name="CrateRowSelected">#1406b6d4</SetVariable>
  <SetVariable name="CrateAccentHiBorder">#6667e8f9</SetVariable>
  <SetVariable name="CrateWarningText">#f9c94a</SetVariable>
  <SetVariable name="CrateRule">1</SetVariable>
  <SetVariable name="CrateActiveBarWidth">2</SetVariable>
  <SetVariable name="CrateStatusDot">6</SetVariable>
  <SetVariable name="CrateTrackingCaps">0.14</SetVariable>
  <SetVariable name="CrateLineHeightLabel">1.4</SetVariable>
  <SetVariable name="CrateLibRowHeight">30</SetVariable>
  <SetVariable name="CrateLibHeaderHeight">32</SetVariable>
  <SetVariable name="CrateLibCellPadding">10</SetVariable>
  <SetVariable name="CrateLibDeckMarkWidth">34</SetVariable>
  <SetVariable name="CrateLibColumnBpm">76</SetVariable>
  <SetVariable name="CrateLibColumnKey">54</SetVariable>
  <SetVariable name="CrateLibColumnTime">60</SetVariable>
  <SetVariable name="CrateLibColumnEnergy">46</SetVariable>
  <SetVariable name="CrateLibColumnProfile">108</SetVariable>
  <SetVariable name="CrateLibColumnCache">58</SetVariable>
  <SetVariable name="CrateLibColumnArtist">0.16</SetVariable>
  <SetVariable name="CrateLibColumnGenre">0.13</SetVariable>
  <SetVariable name="CrateLibFontSizeText">13</SetVariable>

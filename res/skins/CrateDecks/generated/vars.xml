<!--
  Crate Decks skin variables, from res/crate-design/tokens.json.
  Template for tools/crate-design/generate.py. Colours are #rrggbb, or
  #aarrggbb when they have alpha; lengths are in pixels.

  A <Template> keeps its variables to itself, so skin.xml instantiates this
  file and this file instantiates the layout of the skin (main.xml) at its
  end: every template of the skin then sees these variables. C++ reads the
  layout breakpoints from here too (crate/ui/skin/).
-->
<Template>
  <!-- Surfaces and text -->
  <SetVariable name="CrateBgApp">#0a0a0f</SetVariable>
  <SetVariable name="CrateBgPanel">#0d0e14</SetVariable>
  <SetVariable name="CrateBgRaised">#0f1016</SetVariable>
  <SetVariable name="CrateBorder">#1af1f5f9</SetVariable>
  <SetVariable name="CrateTextPrimary">#f1f5f9</SetVariable>
  <SetVariable name="CrateTextMuted">#999ca0</SetVariable>
  <SetVariable name="CrateTextSubtle">#7e8084</SetVariable>
  <SetVariable name="CrateAccent">#06b6d4</SetVariable>
  <SetVariable name="CrateAccentHi">#67e8f9</SetVariable>
  <SetVariable name="CrateWarning">#fbbf24</SetVariable>
  <SetVariable name="CrateDanger">#ef4444</SetVariable>

  <!-- Fonts -->
  <SetVariable name="CrateFontBody">Roboto</SetVariable>
  <SetVariable name="CrateFontDisplay">Bricolage Grotesque</SetVariable>
  <SetVariable name="CrateFontMono">JetBrains Mono</SetVariable>
  <SetVariable name="CrateDeckNumberFont">Bricolage Grotesque</SetVariable>
  <SetVariable name="CrateDeckNumberWeight">700</SetVariable>
  <SetVariable name="CrateDeckNumberSize">34</SetVariable>
  <SetVariable name="CrateDeckNumberSizeCompact">26</SetVariable>
  <SetVariable name="CrateHotcueRadius">10</SetVariable>

  <!-- Deck colours (design 14.3): A and C cyan, B and D cold white -->
  <SetVariable name="CrateDeckA">#67e8f9</SetVariable>
  <SetVariable name="CrateDeckB">#f1f5f9</SetVariable>
  <SetVariable name="CrateDeckC">#67e8f9</SetVariable>
  <SetVariable name="CrateDeckD">#f1f5f9</SetVariable>

  <!-- Waveforms and overviews -->
  <SetVariable name="CrateWaveBg">#0a0a0f</SetVariable>
  <SetVariable name="CrateWaveLowAccent">#0e7490</SetVariable>
  <SetVariable name="CrateWaveMidAccent">#06b6d4</SetVariable>
  <SetVariable name="CrateWaveHighAccent">#67e8f9</SetVariable>
  <SetVariable name="CrateWaveLowNeutral">#4a4c52</SetVariable>
  <SetVariable name="CrateWaveMidNeutral">#999ca0</SetVariable>
  <SetVariable name="CrateWaveHighNeutral">#f1f5f9</SetVariable>
  <SetVariable name="CrateWavePlayhead">#f1f5f9</SetVariable>
  <SetVariable name="CrateWaveBeat">#33f1f5f9</SetVariable>
  <SetVariable name="CrateWaveDownbeat">#66f1f5f9</SetVariable>
  <SetVariable name="CrateWaveOverviewBg">#0d0e14</SetVariable>
  <SetVariable name="CrateWaveOverviewPlayed">#8c0a0a0f</SetVariable>
  <!-- Bands per deck pair: wavePaletteDeckAC picks the logo bands
       (Accent) or the reserve greys for decks A and C -->
  <SetVariable name="CrateWaveLowAC">#0e7490</SetVariable>
  <SetVariable name="CrateWaveMidAC">#06b6d4</SetVariable>
  <SetVariable name="CrateWaveHighAC">#67e8f9</SetVariable>
  <SetVariable name="CrateWaveLowBD">#4a4c52</SetVariable>
  <SetVariable name="CrateWaveMidBD">#999ca0</SetVariable>
  <SetVariable name="CrateWaveHighBD">#f1f5f9</SetVariable>

  <!-- Level meters -->
  <SetVariable name="CrateVuLevel">#67e8f9</SetVariable>
  <SetVariable name="CrateVuWarning">#fbbf24</SetVariable>
  <SetVariable name="CrateVuClip">#ef4444</SetVariable>
  <SetVariable name="CrateVuTrack">#0ff1f5f9</SetVariable>
  <SetVariable name="CrateVuClipTrack">#2eef4444</SetVariable>
  <SetVariable name="CrateVuWarningDb">-6</SetVariable>
  <SetVariable name="CrateVuBarWidth">4</SetVariable>

  <!-- Knobs: the arc is painted by WKnobComposed over knob-scale.svg, in
       the colour of the deck (CrateDeckA to CrateDeckD) -->
  <SetVariable name="CrateKnobSize">36</SetVariable>
  <SetVariable name="CrateKnobSizeCompact">30</SetVariable>
  <SetVariable name="CrateKnobArcColor">#67e8f9</SetVariable>
  <SetVariable name="CrateKnobArcWidth">1.5</SetVariable>
  <SetVariable name="CrateKnobDot">3</SetVariable>
  <SetVariable name="CrateKnobSweep">270</SetVariable>

  <!-- Faders -->
  <SetVariable name="CrateFaderRail">1</SetVariable>
  <SetVariable name="CrateFaderHandleWidth">18</SetVariable>
  <SetVariable name="CrateFaderHandleHeight">10</SetVariable>

  <!-- Layout: the 1366 x 768 breakpoints of the GU1 mockups (C++ sets
       [CrateDecks],layout_narrow and layout_short from them) -->
  <SetVariable name="CrateLayoutNarrowBelow">1500</SetVariable>
  <SetVariable name="CrateLayoutShortBelow">800</SetVariable>
  <!-- Toolbar readings -->
  <SetVariable name="CrateReadingMinWidth">64</SetVariable>
  <SetVariable name="CrateLaneMeter">1</SetVariable>

  <!-- Cache and download level ring -->
  <SetVariable name="CrateLevelRingRadius">7</SetVariable>
  <SetVariable name="CrateLevelRingWidth">1.5</SetVariable>

  <!-- The layout of the skin, with every variable above in scope -->
  <Template src="skins:CrateDecks/main.xml"/>
</Template>

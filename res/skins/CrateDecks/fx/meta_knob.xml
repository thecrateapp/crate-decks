<!DOCTYPE template>
<!--
  Description:
    The meta knob of an effect slot: a rack knob (controls/rack_knob.xml)
    that is an EffectMetaKnob.
  Variables:
    FxRack_FxUnit_FxNum : [EffectRack1_EffectUnitX_EffectY]
-->
<Template>
  <WidgetGroup>
    <Layout>horizontal</Layout>
    <ObjectName>CrateRackKnobBox</ObjectName>
    <SizePolicy>f,max</SizePolicy>
    <Children>
      <EffectMetaKnob>
        <TooltipId>EffectSlot_metaknob</TooltipId>
        <ObjectName>CrateRackKnob</ObjectName>
        <BackPath scalemode="STRETCH">skins:CrateDecks/generated/controls/knob-scale.svg</BackPath>
        <Knob scalemode="STRETCH">skins:CrateDecks/generated/controls/knob-dot.svg</Knob>
        <MinAngle>-<Variable name="CrateKnobHalfSweep"/></MinAngle>
        <MaxAngle><Variable name="CrateKnobHalfSweep"/></MaxAngle>
        <ArcRadius><Variable name="CrateKnobArcRadiusCompact"/></ArcRadius>
        <ArcThickness><Variable name="CrateKnobArcWidth"/></ArcThickness>
        <ArcRoundCaps>true</ArcRoundCaps>
        <ArcColor><Variable name="CrateKnobArcColor"/></ArcColor>
        <EffectUnit><Variable name="FxUnit"/></EffectUnit>
        <Effect><Variable name="FxNum"/></Effect>
        <Connection>
          <ConfigKey>[<Variable name="FxRack_FxUnit_FxNum"/>],meta</ConfigKey>
        </Connection>
      </EffectMetaKnob>
    </Children>
  </WidgetGroup>
</Template>

<!DOCTYPE template>
<!--
  Description:
    An effect parameter knob.
  Variables:
    EffectRack: the rack
    EffectUnit: the unit
    Effect: the effect
    EffectParameter: the parameter
-->
<Template>
  <SetVariable name="FxUnitGroup">[EffectRack1_EffectUnit<Variable name="FxUnit"/>]</SetVariable>
  <SetVariable name="FxRack_FxUnit_FxNum"><Variable name="FxRack_FxUnit"/>_Effect<Variable name="FxNum"/></SetVariable>

  <WidgetGroup>
    <ObjectName>CrateFxParameter</ObjectName>
    <Layout>vertical</Layout>
    <MinimumSize>40,</MinimumSize>
    <MaximumSize>60,</MaximumSize>
    <SizePolicy>me,min</SizePolicy>
    <Children>
      <WidgetGroup>
        <ObjectName>CrateFxParameterKnob</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,min</SizePolicy>
        <Children>
          <WidgetGroup><SizePolicy>me,min</SizePolicy></WidgetGroup>
          <!-- A rack knob (controls/rack_knob.xml) at the four decks' short
               size, knobSizeFourShort -->
          <EffectParameterKnobComposed>
            <ObjectName>CrateRackKnobSmall</ObjectName>
            <BackPath scalemode="STRETCH">skins:CrateDecks/generated/controls/knob-scale.svg</BackPath>
            <Knob scalemode="STRETCH">skins:CrateDecks/generated/controls/knob-dot.svg</Knob>
            <MinAngle>-<Variable name="CrateKnobHalfSweep"/></MinAngle>
            <MaxAngle><Variable name="CrateKnobHalfSweep"/></MaxAngle>
            <EffectUnitGroup><Variable name="FxUnitGroup"/></EffectUnitGroup>
            <Effect><Variable name="FxNum"/></Effect>
            <EffectParameter><Variable name="FxParameter"/></EffectParameter>
            <ArcRadius><Variable name="CrateKnobArcRadiusFourShort"/></ArcRadius>
            <ArcColor><Variable name="CrateKnobArcColor"/></ArcColor>
            <ArcThickness><Variable name="CrateKnobArcWidth"/></ArcThickness>
            <ArcRoundCaps>true</ArcRoundCaps>
            <ArcUnipolar>true</ArcUnipolar>
            <Connection>
              <ConfigKey>[<Variable name="FxRack_FxUnit_FxNum"/>],parameter<Variable name="FxParameter"/></ConfigKey>
            </Connection>
          </EffectParameterKnobComposed>
          <WidgetGroup><SizePolicy>me,min</SizePolicy></WidgetGroup>
        </Children>
      </WidgetGroup>

      <EffectParameterName>
        <ObjectName>MonoFxParameterName</ObjectName>
        <SizePolicy>me,f</SizePolicy>
        <EffectRack>1</EffectRack>
        <EffectUnit><Variable name="FxUnit"/></EffectUnit>
        <Effect><Variable name="FxNum"/></Effect>
        <EffectParameter><Variable name="FxParameter"/></EffectParameter>
        <Alignment>center</Alignment>
        <Elide>right</Elide>
      </EffectParameterName>

      <WidgetGroup>
        <ObjectName>CrateFxLinkButtons</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>
          <WidgetGroup><Size>0min,0min</Size></WidgetGroup>
          <!-- Meta knob link invert button -->
          <Template src="skins:CrateDecks/controls/rack_button.xml">
            <SetVariable name="TooltipId">EffectSlot_parameter_inversion</SetVariable>
            <SetVariable name="ObjectName">CrateRackLinkInvert</SetVariable>
            <SetVariable name="Text"></SetVariable>
            <SetVariable name="ConfigKey">[<Variable name="FxRack_FxUnit_FxNum"/>],parameter<Variable name="FxParameter"/>_link_inverse</SetVariable>
          </Template>

          <!-- Meta knob link button -->
          <!-- Link type: none, linked, left, right, left and right -->
          <PushButton>
            <TooltipId>EffectSlot_parameter_link_type</TooltipId>
            <ObjectName>CrateRackLink</ObjectName>
            <NumberStates>5</NumberStates>
            <RightClickIsPushButton>true</RightClickIsPushButton>
            <State><Number>0</Number></State>
            <State><Number>1</Number></State>
            <State><Number>2</Number></State>
            <State><Number>3</Number></State>
            <State><Number>4</Number></State>
            <Connection>
              <ConfigKey>[<Variable name="FxRack_FxUnit_FxNum"/>],parameter<Variable name="FxParameter"/>_link_type</ConfigKey>
              <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
              <ButtonState>LeftButton</ButtonState>
            </Connection>
          </PushButton>
          <WidgetGroup><Size>0min,0min</Size></WidgetGroup>
        </Children>
      </WidgetGroup>

    </Children>
    <Connection>
      <ConfigKey>[<Variable name="FxRack_FxUnit_FxNum"/>],parameter<Variable name="FxParameter"/>_loaded</ConfigKey>
      <BindProperty>visible</BindProperty>
    </Connection>
  </WidgetGroup>
</Template>

<!--
Description:
  Assigns a channel to an effect unit: a rack text button
  (controls/rack_button.xml) that reads "FX 1", "2"...
Variables:
  FxUnit, Group, Type : the effect unit, the channel and the tooltip's kind
  Text                : what comes before the unit's number
-->
<Template>
  <PushButton>
    <TooltipId>EffectUnit_<Variable name="Type"/>_enabled</TooltipId>
    <ObjectName>CrateRackButtonAssign</ObjectName>
    <NumberStates>2</NumberStates>
    <RightClickIsPushButton>false</RightClickIsPushButton>
    <State>
      <Number>0</Number>
      <Text><Variable name="Text"/><Variable name="FxUnit"/></Text>
      <Alignment>center</Alignment>
    </State>
    <State>
      <Number>1</Number>
      <Text><Variable name="Text"/><Variable name="FxUnit"/></Text>
      <Alignment>center</Alignment>
    </State>
    <Connection>
      <ConfigKey>[EffectRack1_EffectUnit<Variable name="FxUnit"/>],group_<Variable name="Group"/>_enable</ConfigKey>
      <ButtonState>LeftButton</ButtonState>
    </Connection>
  </PushButton>
</Template>

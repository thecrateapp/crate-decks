<!--
  Pitch column of a deck (GU1 mockups .pitch): MonoLabel, the rate fader
  with the instrument scale of design 14.3 and its value. The handle fills
  in the deck colour while the fader moves or the deck syncs.
Variables: ChanNum, Pair, Size
-->
<Template>
  <WidgetGroup>
    <ObjectName>CratePitch<Variable name="Size"/></ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>f,me</SizePolicy>
    <Children>
      <Label>
        <ObjectName>MonoPitchLabel</ObjectName>
        <Text>Pitch</Text>
        <Alignment>center</Alignment>
      </Label>
      <!-- The box holds the fader's minimum height, which follows the
           768 px layout class; the sync group fills the handle while the
           deck syncs (crate/ui/skin/mixerstyle.cpp) -->
      <WidgetGroup>
        <ObjectName>CratePitchFaderBox<Variable name="Size"/></ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,me</SizePolicy>
        <Children>
          <WidgetGroup>
            <ObjectName>CrateFaderSync</ObjectName>
            <Layout>horizontal</Layout>
            <SizePolicy>me,me</SizePolicy>
            <Children>
              <WidgetGroup><SizePolicy>me,min</SizePolicy></WidgetGroup>
              <SliderComposed>
                <ObjectName>CrateFaderPitch<Variable name="Pair"/></ObjectName>
                <TooltipId>rate</TooltipId>
                <SizePolicy>f,me</SizePolicy>
                <Handle scalemode="STRETCH">skins:CrateDecks/generated/controls/fader-handle-v<Variable name="CratePitchFaderWidth"/>.svg</Handle>
                <Horizontal>false</Horizontal>
                <Connection>
                  <ConfigKey>[Channel<Variable name="ChanNum"/>],rate</ConfigKey>
                </Connection>
              </SliderComposed>
              <WidgetGroup><SizePolicy>me,min</SizePolicy></WidgetGroup>
            </Children>
            <Connection>
              <ConfigKey>[Channel<Variable name="ChanNum"/>],sync_enabled</ConfigKey>
              <BindProperty>highlight</BindProperty>
            </Connection>
          </WidgetGroup>
        </Children>
        <Connection>
          <ConfigKey>[CrateDecks],layout_short</ConfigKey>
          <BindProperty>highlight</BindProperty>
        </Connection>
      </WidgetGroup>
      <NumberRate>
        <ObjectName>CratePitchValue</ObjectName>
        <TooltipId>rate_display</TooltipId>
        <Alignment>center</Alignment>
        <Channel><Variable name="ChanNum"/></Channel>
        <NumberOfDigits>2</NumberOfDigits>
      </NumberRate>
    </Children>
  </WidgetGroup>
</Template>

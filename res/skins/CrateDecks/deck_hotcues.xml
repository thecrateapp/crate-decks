<!--
  Hotcues as numbered nodes (GU1 proposal): hollow at rest, stroked in the
  deck colour when set.
Variables: ChanNum, Pair, Size
-->
<Template>
  <SetVariable name="Group">[Channel<Variable name="ChanNum"/>]</SetVariable>
  <WidgetGroup>
    <ObjectName>CrateHotcues<Variable name="Size"/></ObjectName>
    <Layout>horizontal</Layout>
    <SizePolicy>min,min</SizePolicy>
    <Children>
      <Template src="skins:CrateDecks/controls/hotcue_node.xml"><SetVariable name="Number">1</SetVariable></Template>
      <Template src="skins:CrateDecks/controls/hotcue_node.xml"><SetVariable name="Number">2</SetVariable></Template>
      <Template src="skins:CrateDecks/controls/hotcue_node.xml"><SetVariable name="Number">3</SetVariable></Template>
      <Template src="skins:CrateDecks/controls/hotcue_node.xml"><SetVariable name="Number">4</SetVariable></Template>
      <Template src="skins:CrateDecks/controls/hotcue_node.xml"><SetVariable name="Number">5</SetVariable></Template>
      <Template src="skins:CrateDecks/controls/hotcue_node.xml"><SetVariable name="Number">6</SetVariable></Template>
      <Template src="skins:CrateDecks/controls/hotcue_node.xml"><SetVariable name="Number">7</SetVariable></Template>
      <Template src="skins:CrateDecks/controls/hotcue_node.xml"><SetVariable name="Number">8</SetVariable></Template>
    </Children>
  </WidgetGroup>
</Template>

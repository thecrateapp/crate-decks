<Template>
  <SetVariable name="Group">[Auxiliary<Variable name="AuxNum"/>]</SetVariable>
  <SetVariable name="Type">auxiliary</SetVariable>

  <!-- input device is configured -->
  <WidgetGroup>
    <Layout>horizontal</Layout>
    <SizePolicy>min,min</SizePolicy>
    <Children>

      <WidgetGroup>
        <ObjectName>CrateMicAuxUnit</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>

          <WidgetGroup>
            <ObjectName>CrateMicAuxMainControls</ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>min,me</SizePolicy>
            <Children>

              <Label>
                <ObjectName>MonoMicAuxLabel</ObjectName>
                <Text>Aux <Variable name="AuxNum"/></Text>
                <Alignment>center</Alignment>
              </Label>

              <Template src="skins:CrateDecks/mic_aux/orientation_buttons.xml"/>

              <WidgetGroup>
                <ObjectName>CrateAuxPlayBox</ObjectName>
                <Layout>vertical</Layout>
                <SizePolicy>min,me</SizePolicy>
                <Children>
                  <Template src="skins:CrateDecks/controls/rack_button.xml">
                    <SetVariable name="TooltipId">main_enable</SetVariable>
                    <SetVariable name="ObjectName">CrateRackButtonOn</SetVariable>
                    <SetVariable name="Text">On</SetVariable>
                    <SetVariable name="ConfigKey"><Variable name="Group"/>,main_mix</SetVariable>
                  </Template>
                </Children>
              </WidgetGroup>

            </Children>
          </WidgetGroup><!-- MicAuxMainControls -->

          <WidgetGroup>
            <ObjectName>CrateMicAuxVUMeter</ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>min,me</SizePolicy>
            <Children>
              <Template src="skins:CrateDecks/mixer_vu.xml">
                <SetVariable name="VuKey">vu_meter</SetVariable>
                <SetVariable name="PeakKey">peak_indicator</SetVariable>
                <SetVariable name="Colour">Main</SetVariable>
              </Template>
            </Children>
          </WidgetGroup>

          <WidgetGroup><!-- Gain, Pfl, FX buttons-->
            <ObjectName>CrateMicAuxSubControls</ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>min,me</SizePolicy>
            <Children>
              <WidgetGroup>
                <ObjectName>CrateMicAuxGainPFlContainer</ObjectName>
                <Layout>horizontal</Layout>
                <SizePolicy>min,me</SizePolicy>
                <Children>
                  <Template src="skins:CrateDecks/controls/rack_knob.xml">
                    <SetVariable name="TooltipId">auxiliary_pregain</SetVariable>
                    <SetVariable name="ArcUnipolar">true</SetVariable>
                    <SetVariable name="Control">pregain</SetVariable>
                  </Template>
                  <WidgetGroup>
                    <ObjectName>AlignHCenter</ObjectName>
                    <Layout>vertical</Layout>
                    <SizePolicy>min,min</SizePolicy>
                    <Children>
                      <Template src="skins:CrateDecks/controls/rack_button.xml">
                        <SetVariable name="TooltipId">pfl</SetVariable>
                        <SetVariable name="ObjectName">CrateRackPfl</SetVariable>
                        <SetVariable name="Text"></SetVariable>
                        <SetVariable name="ConfigKey"><Variable name="Group"/>,pfl</SetVariable>
                      </Template>
                    </Children>
                  </WidgetGroup>
                  <WidgetGroup><Size>0min,0min</Size></WidgetGroup>
                </Children>
              </WidgetGroup><!-- MicAuxGainPFlContainer -->

              <WidgetGroup><Size>0min,0min</Size></WidgetGroup>

              <WidgetGroup>
                <ObjectName>AlignHCenter</ObjectName>
                <Layout>vertical</Layout>
                <SizePolicy>min,min</SizePolicy>
                <Children>
                  <Template src="skins:CrateDecks/fx/assign_buttons.xml"/>
                </Children>
              </WidgetGroup>

            </Children>
          </WidgetGroup><!-- MicAuxSubControls / Gain, Pfl, FX buttons-->

        </Children>
      </WidgetGroup><!-- MicAuxUnit -->

    </Children>
    <Connection>
      <ConfigKey><Variable name="Group"/>,input_configured</ConfigKey>
      <BindProperty>visible</BindProperty>
    </Connection>
  </WidgetGroup>
</Template>

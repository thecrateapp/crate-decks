<!--
  Overview of a sampler, as a deck's (deck_overview.xml) in the neutral
  palette of design 14.3, with the played part dimmed and cues in the
  accent: a sampler has no deck colour.
Variables: Group
-->
<Template>
  <Overview>
    <ObjectName>CrateSamplerOverview</ObjectName>
    <TooltipId>waveform_overview</TooltipId>
    <Size>145me,20me</Size>
    <Group><Variable name="Group"/></Group>
    <Connection>
      <ConfigKey><Variable name="Group"/>,playposition</ConfigKey>
    </Connection>
    <BgColor><Variable name="CrateWaveOverviewBg"/></BgColor>
    <SignalColor><Variable name="CrateWaveMidNeutral"/></SignalColor>
    <SignalLowColor><Variable name="CrateWaveLowNeutral"/></SignalLowColor>
    <SignalMidColor><Variable name="CrateWaveMidNeutral"/></SignalMidColor>
    <SignalHighColor><Variable name="CrateWaveHighNeutral"/></SignalHighColor>
    <SignalRGBLowColor><Variable name="CrateWaveLowNeutral"/></SignalRGBLowColor>
    <SignalRGBMidColor><Variable name="CrateWaveMidNeutral"/></SignalRGBMidColor>
    <SignalRGBHighColor><Variable name="CrateWaveHighNeutral"/></SignalRGBHighColor>
    <PlayedOverlayColor><Variable name="CrateWaveOverviewPlayed"/></PlayedOverlayColor>
    <PlayPosColor><Variable name="CrateWavePlayhead"/></PlayPosColor>
    <EndOfTrackColor><Variable name="CrateWarning"/></EndOfTrackColor>
    <DefaultMark>
      <Align>top|left</Align>
      <Color><Variable name="CrateAccentHi"/></Color>
      <TextColor><Variable name="CrateBgApp"/></TextColor>
      <Text> %1 </Text>
    </DefaultMark>
    <Mark>
      <Control>cue_point</Control>
      <Align>bottom|left</Align>
      <Color><Variable name="CrateAccentHi"/></Color>
      <TextColor><Variable name="CrateBgApp"/></TextColor>
    </Mark>
    <MarkRange>
      <StartControl>intro_start_position</StartControl>
      <EndControl>intro_end_position</EndControl>
      <VisibilityControl>[Skin],show_intro_outro_cues</VisibilityControl>
      <Color><Variable name="CrateAccentHi"/></Color>
      <Opacity>0.12</Opacity>
    </MarkRange>
    <MarkRange>
      <StartControl>outro_start_position</StartControl>
      <EndControl>outro_end_position</EndControl>
      <VisibilityControl>[Skin],show_intro_outro_cues</VisibilityControl>
      <Color><Variable name="CrateAccentHi"/></Color>
      <Opacity>0.12</Opacity>
    </MarkRange>
  </Overview>
</Template>

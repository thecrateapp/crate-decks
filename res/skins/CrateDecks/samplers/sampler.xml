<Template>
  <SetVariable name="Group">[Sampler<Variable name="SamplerNum"/>]</SetVariable>

  <WidgetGroup>
    <ObjectName>CrateSampler</ObjectName>
    <Layout>horizontal</Layout>
    <SizePolicy>me,min</SizePolicy>
    <Children>

      <WidgetGroup>
        <ObjectName>CrateSamplerMainControls</ObjectName>
        <Layout>vertical</Layout>
        <SizePolicy>me,me</SizePolicy>
        <Children>

          <WidgetGroup>
            <ObjectName>CrateSamplerTitleRow</ObjectName>
            <Layout>horizontal</Layout>
            <SizePolicy>i,me</SizePolicy>
            <Children>
              <TrackProperty>
                <TooltipId>track_title</TooltipId>
                <ObjectName>CrateSamplerTitle</ObjectName>
                <SizePolicy>me,me</SizePolicy>
                <Group><Variable name="Group"/></Group>
                <Property>titleInfo</Property>
                <Elide>right</Elide>
              </TrackProperty>

              <WidgetGroup>
                <ObjectName>CrateSamplerTitleBpmSeparator</ObjectName>
                <Layout>horizontal</Layout>
                <SizePolicy>f,me</SizePolicy>
                <Children/>
              </WidgetGroup>

              <Number>
                <TooltipId>visual_bpm</TooltipId>
                <ObjectName>MonoSamplerBpm</ObjectName>
                <Group><Variable name="Group"/></Group>
                <Alignment>center</Alignment>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,visual_bpm</ConfigKey>
                </Connection>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,track_loaded</ConfigKey>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </Number>

              <WidgetGroup>
                <Size>49f,0min</Size>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,track_loaded</ConfigKey>
                  <Transform><Not/></Transform>
                  <BindProperty>visible</BindProperty>
                </Connection>
              </WidgetGroup>
            </Children>
          </WidgetGroup>

      <!-- Play Overview Settings | Gain |  VU
           Hotcues                | Pfl  | meter -->
          <WidgetGroup>
            <ObjectName>CrateSamplerRows23</ObjectName>
            <Layout>horizontal</Layout>
            <SizePolicy>me,me</SizePolicy>
            <Children>
              <!-- Play Overview Settings  -->
              <WidgetGroup>
                <ObjectName>CrateSamplerPlayRow</ObjectName>
                <Layout>vertical</Layout>
                <SizePolicy>me,me</SizePolicy>
                <Children>

                  <WidgetGroup>
                    <ObjectName></ObjectName>
                    <Layout>horizontal</Layout>
                    <SizePolicy>me,me</SizePolicy>
                    <Children>

                      <WidgetGroup>
                        <ObjectName>CrateSamplerPlayBox</ObjectName>
                        <Layout>stacked</Layout>
                        <SizePolicy>max,max</SizePolicy>
                        <Children>
                          <Template src="skins:CrateDecks/samplers/play_button.xml"/>
                        </Children>
                      </WidgetGroup>

                      <WidgetGroup>
                        <ObjectName>CrateSamplerOverviewBox</ObjectName>
                        <Layout>horizontal</Layout>
                        <SizePolicy>me,min</SizePolicy>
                        <Children>
                          <Template src="skins:CrateDecks/samplers/overview.xml"/>
                        </Children>
                        <Connection>
                          <ConfigKey><Variable name="Group"/>,track_loaded</ConfigKey>
                          <BindProperty>highlight</BindProperty>
                        </Connection>
                      </WidgetGroup><!-- OverviewBox -->

                      <WidgetGroup>
                        <ObjectName>CrateSamplerSettingsContainer</ObjectName>
                        <Layout>vertical</Layout>
                        <SizePolicy>max,min</SizePolicy>
                        <Children>
                          <WidgetGroup>
                            <ObjectName>CrateSamplerSettings</ObjectName>
                            <Layout>vertical</Layout>
                            <SizePolicy>max,min</SizePolicy>
                            <Children>
                              <WidgetGroup>
                                <Layout>horizontal</Layout>
                                <SizePolicy>min,min</SizePolicy>
                                <Children>
                                  <Template src="skins:CrateDecks/controls/rack_button.xml">
                                    <SetVariable name="TooltipId">repeat</SetVariable>
                                    <SetVariable name="ObjectName">CrateRackRepeat</SetVariable>
                                    <SetVariable name="Text"></SetVariable>
                                    <SetVariable name="ConfigKey"><Variable name="Group"/>,repeat</SetVariable>
                                  </Template>
                                  <Template src="skins:CrateDecks/samplers/eject_button.xml"/>
                                </Children>
                              </WidgetGroup>

                              <WidgetGroup>
                                <Layout>horizontal</Layout>
                                <SizePolicy>min,min</SizePolicy>
                                <Children>
                                  <Template src="skins:CrateDecks/controls/rack_button.xml">
                                    <SetVariable name="TooltipId">keylock</SetVariable>
                                    <SetVariable name="ObjectName">CrateRackButtonKey</SetVariable>
                                    <SetVariable name="Text">Key</SetVariable>
                                    <SetVariable name="ConfigKey"><Variable name="Group"/>,keylock</SetVariable>
                                  </Template>
                                  <Template src="skins:CrateDecks/samplers/orientation_button.xml"/>
                                </Children>
                              </WidgetGroup>
                            </Children>
                          </WidgetGroup><!-- CrateSamplerSettings -->
                        </Children>
                      </WidgetGroup><!-- SamplerSettingsContainer -->
                    </Children>
                  </WidgetGroup><!-- Play + overview + settings + gain -->

                  <WidgetGroup><!-- hotcues + pfl -->
                    <ObjectName>CrateSamplerButtons</ObjectName>
                    <Layout>horizontal</Layout>
                    <SizePolicy>me,min</SizePolicy>
                    <Children>

                      <WidgetGroup>
                        <ObjectName>CrateSamplerHotcues</ObjectName>
                        <Layout>horizontal</Layout>
                        <SizePolicy>min,min</SizePolicy>
                        <Children>
                          <Template src="skins:CrateDecks/controls/hotcue_node.xml">
                            <SetVariable name="Number">1</SetVariable>
                            <SetVariable name="Size"></SetVariable>
                            <SetVariable name="Pair">AC</SetVariable>
                          </Template>

                          <Template src="skins:CrateDecks/controls/hotcue_node.xml">
                            <SetVariable name="Number">2</SetVariable>
                            <SetVariable name="Size"></SetVariable>
                            <SetVariable name="Pair">AC</SetVariable>
                          </Template>

                          <Template src="skins:CrateDecks/controls/hotcue_node.xml">
                            <SetVariable name="Number">3</SetVariable>
                            <SetVariable name="Size"></SetVariable>
                            <SetVariable name="Pair">AC</SetVariable>
                          </Template>

                          <Template src="skins:CrateDecks/controls/hotcue_node.xml">
                            <SetVariable name="Number">4</SetVariable>
                            <SetVariable name="Size"></SetVariable>
                            <SetVariable name="Pair">AC</SetVariable>
                          </Template>

                          <WidgetGroup><!-- /Hotcues 5-8 -->
                            <Layout>horizontal</Layout>
                            <SizePolicy>f,min</SizePolicy>
                            <Children>
                              <Template src="skins:CrateDecks/controls/hotcue_node.xml">
                                <SetVariable name="Number">5</SetVariable>
                                <SetVariable name="Size"></SetVariable>
                                <SetVariable name="Pair">AC</SetVariable>
                              </Template>

                              <Template src="skins:CrateDecks/controls/hotcue_node.xml">
                                <SetVariable name="Number">6</SetVariable>
                                <SetVariable name="Size"></SetVariable>
                                <SetVariable name="Pair">AC</SetVariable>
                              </Template>

                              <Template src="skins:CrateDecks/controls/hotcue_node.xml">
                                <SetVariable name="Number">7</SetVariable>
                                <SetVariable name="Size"></SetVariable>
                                <SetVariable name="Pair">AC</SetVariable>
                              </Template>

                              <Template src="skins:CrateDecks/controls/hotcue_node.xml">
                                <SetVariable name="Number">8</SetVariable>
                                <SetVariable name="Size"></SetVariable>
                                <SetVariable name="Pair">AC</SetVariable>
                              </Template>
                            </Children>
                            <Connection>
                              <ConfigKey persist="true">[Skin],show_8_hotcues</ConfigKey>
                              <BindProperty>visible</BindProperty>
                            </Connection>
                          </WidgetGroup><!-- /Hotcues 5-8 -->

                          <WidgetGroup>
                            <SizePolicy>me,min</SizePolicy>
                          </WidgetGroup>

                          <WidgetGroup>
                            <Layout>horizontal</Layout>
                            <SizePolicy>f,min</SizePolicy>
                            <Children>
                              <Template src="skins:CrateDecks/fx/assign_buttons.xml">
                                <SetVariable name="Type">headphones</SetVariable>
                              </Template>
                            </Children>
                            <Connection>
                              <ConfigKey persist="true">[Skin],show_sampler_fx</ConfigKey>
                              <BindProperty>visible</BindProperty>
                            </Connection>
                          </WidgetGroup>

                          <WidgetGroup><SizePolicy>me,min</SizePolicy></WidgetGroup>

                        </Children>
                      </WidgetGroup><!-- SamplerHotcues -->

                    </Children>
                  </WidgetGroup><!-- hotcues + pfl -->

                </Children>
              </WidgetGroup><!--  * Play, Overview, Controls, Gain
                                  * hotcues + Pfl  -->

              <WidgetGroup>
                <ObjectName>CrateSamplerGainPflVu_Container</ObjectName>
                <Layout>horizontal</Layout>
                <SizePolicy>f,me</SizePolicy>
                <Children>
                  <WidgetGroup>
                    <ObjectName>CrateSamplerGainPflVu</ObjectName>
                    <Layout>horizontal</Layout>
                    <SizePolicy>f,me</SizePolicy>
                    <Children>
                      <WidgetGroup>
                        <!-- <ObjectName>CrateSamplerGainPflVu</ObjectName> -->
                        <Layout>vertical</Layout>
                        <SizePolicy>f,me</SizePolicy>
                        <Children>
                          <WidgetGroup>
                            <ObjectName>CrateSamplerGain</ObjectName>
                            <Layout>horizontal</Layout>
                            <SizePolicy>min,min</SizePolicy>
                            <Children>
                              <Template src="skins:CrateDecks/controls/rack_knob.xml">
                                <SetVariable name="TooltipId">pregain</SetVariable>
                                <SetVariable name="ArcUnipolar">true</SetVariable>
                                <SetVariable name="Group"><Variable name="Group"/></SetVariable>
                                <SetVariable name="Control">pregain</SetVariable>
                              </Template>
                            </Children>
                          </WidgetGroup><!-- CrateSamplerGain -->

                          <WidgetGroup><SizePolicy>me,me</SizePolicy></WidgetGroup>

                          <WidgetGroup>
                            <ObjectName>CrateSamplerPfl</ObjectName>
                            <Layout>horizontal</Layout>
                            <Children>
                              <Template src="skins:CrateDecks/controls/rack_button.xml">
                                <SetVariable name="TooltipId">pfl</SetVariable>
                                <SetVariable name="ObjectName">CrateRackPfl</SetVariable>
                                <SetVariable name="Text"></SetVariable>
                                <SetVariable name="ConfigKey"><Variable name="Group"/>,pfl</SetVariable>
                              </Template>
                            </Children>
                          </WidgetGroup><!-- CrateSamplerPfl -->
                        </Children>
                      </WidgetGroup><!-- SamplerGainPfl -->

                      <WidgetGroup>
                        <ObjectName>CrateSamplerVU</ObjectName>
                        <Layout>vertical</Layout>
                        <SizePolicy>f,me</SizePolicy>
                        <Children>
                          <Template src="skins:CrateDecks/mixer_vu.xml">
                            <SetVariable name="VuKey">vu_meter</SetVariable>
                            <SetVariable name="PeakKey">peak_indicator</SetVariable>
                            <SetVariable name="Colour">Main</SetVariable>
                          </Template>
                        </Children>
                      </WidgetGroup><!-- CrateSamplerVU -->
                    </Children>
                  </WidgetGroup>
                </Children>
              </WidgetGroup><!-- SamplerGainPfl -->

            </Children>
          </WidgetGroup><!--  * Play, Overview, Controls, Gain  | VU
                              * hotcues + Pfl                   |  meter -->

        </Children>
      </WidgetGroup><!-- /SamplerMainControls -->

      <WidgetGroup>
        <ObjectName>CrateSamplerRateControls</ObjectName>
        <Layout>vertical</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>
          <WidgetGroup>
            <ObjectName>AlignHCenter</ObjectName>
            <Layout>horizontal</Layout>
            <SizePolicy>min,min</SizePolicy>
            <Children>
              <Template src="skins:CrateDecks/controls/rack_button.xml">
                <SetVariable name="TooltipId">sync_enabled</SetVariable>
                <SetVariable name="ObjectName">CrateRackButtonSync</SetVariable>
                <SetVariable name="Text">Sync</SetVariable>
                <SetVariable name="ConfigKey"><Variable name="Group"/>,sync_enabled</SetVariable>
              </Template>
            </Children>
          </WidgetGroup>

          <WidgetGroup>
            <ObjectName>CrateSamplerPitchSlider</ObjectName>
            <Layout>horizontal</Layout>
            <SizePolicy>min,me</SizePolicy>
            <Children>
              <!-- The decks' pitch fader (deck_pitch.xml) at the mixer's
                   fader width; crate/ui/skin/mixerstyle.cpp paints its scale -->
              <SliderComposed>
                <ObjectName>CrateFaderSampler</ObjectName>
                <TooltipId>rate</TooltipId>
                <SizePolicy>f,me</SizePolicy>
                <Handle scalemode="STRETCH">skins:CrateDecks/generated/controls/fader-handle-v<Variable name="CrateFaderWidth"/>.svg</Handle>
                <Horizontal>false</Horizontal>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,rate</ConfigKey>
                </Connection>
              </SliderComposed>
            </Children>
          </WidgetGroup><!-- SamplerPitchSlider -->
        </Children>
      </WidgetGroup><!-- SamplerRateControls -->

    </Children>
  </WidgetGroup><!-- Sampler -->
</Template>

<Template>
  <WidgetGroup>
    <ObjectName>CrateRack</ObjectName>
    <Layout>horizontal</Layout>
    <SizePolicy>me,max</SizePolicy>
    <Children>

      <WidgetGroup>
        <ObjectName>CrateMicAuxRack</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,min</SizePolicy>
        <Children>

          <WidgetGroup>
            <ObjectName>CrateRackFiller</ObjectName>
            <SizePolicy>me,min</SizePolicy>
          </WidgetGroup>

          <WidgetGroup>
            <ObjectName>CrateMicRack</ObjectName>
            <Layout>horizontal</Layout>
            <SizePolicy>min,min</SizePolicy>
            <Children>

              <Template src="skins:CrateDecks/mic_aux/ducking_controls.xml"/>

              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Children>
                  <Template src="skins:CrateDecks/mic_aux/mic_unit.xml">
                    <SetVariable name="Mic1Hack">1</SetVariable>
                  </Template>
                  <Template src="skins:CrateDecks/mic_aux/mic_unit_unconfigured.xml">
                    <SetVariable name="Mic1Hack">1</SetVariable>
                  </Template>
                </Children>
              </WidgetGroup>

              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Children>
                  <Template src="skins:CrateDecks/mic_aux/mic_unit.xml">
                    <SetVariable name="MicNum">2</SetVariable>
                  </Template>
                  <Template src="skins:CrateDecks/mic_aux/mic_unit_unconfigured.xml">
                    <SetVariable name="MicNum">2</SetVariable>
                  </Template>
                </Children>
              </WidgetGroup>

              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Children>
                  <Template src="skins:CrateDecks/mic_aux/mic_unit.xml">
                    <SetVariable name="MicNum">3</SetVariable>
                  </Template>
                  <Template src="skins:CrateDecks/mic_aux/mic_unit_unconfigured.xml">
                    <SetVariable name="MicNum">3</SetVariable>
                  </Template>
                </Children>
              </WidgetGroup>

              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Children>
                  <Template src="skins:CrateDecks/mic_aux/mic_unit.xml">
                    <SetVariable name="MicNum">4</SetVariable>
                  </Template>
                  <Template src="skins:CrateDecks/mic_aux/mic_unit_unconfigured.xml">
                    <SetVariable name="MicNum">4</SetVariable>
                  </Template>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup><!-- MicRack -->

          <WidgetGroup>
            <ObjectName>CrateRackFiller</ObjectName>
            <SizePolicy>me,min</SizePolicy>
          </WidgetGroup>

          <WidgetGroup>
            <ObjectName>CrateAuxRack</ObjectName>
            <Layout>horizontal</Layout>
            <SizePolicy>min,min</SizePolicy>
            <Children>

              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Children>
                  <Template src="skins:CrateDecks/mic_aux/aux_unit.xml">
                    <SetVariable name="AuxNum">1</SetVariable>
                  </Template>
                  <Template src="skins:CrateDecks/mic_aux/aux_unit_unconfigured.xml">
                    <SetVariable name="AuxNum">1</SetVariable>
                  </Template>
                </Children>
              </WidgetGroup>

              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Children>
                  <Template src="skins:CrateDecks/mic_aux/aux_unit.xml">
                    <SetVariable name="AuxNum">2</SetVariable>
                  </Template>
                  <Template src="skins:CrateDecks/mic_aux/aux_unit_unconfigured.xml">
                    <SetVariable name="AuxNum">2</SetVariable>
                  </Template>
                </Children>
              </WidgetGroup>

              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Children>
                  <Template src="skins:CrateDecks/mic_aux/aux_unit.xml">
                    <SetVariable name="AuxNum">3</SetVariable>
                  </Template>
                  <Template src="skins:CrateDecks/mic_aux/aux_unit_unconfigured.xml">
                    <SetVariable name="AuxNum">3</SetVariable>
                  </Template>
                </Children>
              </WidgetGroup>

              <WidgetGroup>
                <Layout>horizontal</Layout>
                <Children>
                  <Template src="skins:CrateDecks/mic_aux/aux_unit.xml">
                    <SetVariable name="AuxNum">4</SetVariable>
                  </Template>
                  <Template src="skins:CrateDecks/mic_aux/aux_unit_unconfigured.xml">
                    <SetVariable name="AuxNum">4</SetVariable>
                  </Template>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup><!-- AuxRack -->

          <WidgetGroup>
            <ObjectName>CrateRackFiller</ObjectName>
            <SizePolicy>me,min</SizePolicy>
          </WidgetGroup>

        </Children>
      </WidgetGroup><!-- MicAuxRack -->

    </Children>
    <Connection>
      <ConfigKey persist="true">[Skin],show_microphones</ConfigKey>
      <BindProperty>visible</BindProperty>
    </Connection>
  </WidgetGroup>
</Template>
